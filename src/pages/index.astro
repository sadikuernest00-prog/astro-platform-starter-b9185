---
const products = [
  {
    name: "Elegant Lace Set",
    price: 599,
    image: "/images/white-lace.jpg",
    badge: "Best Seller",
  },
  {
    name: "Midnight Black Collection",
    price: 549,
    image: "/images/black-set.jpg",
    badge: "New",
  },
  {
    name: "Luxury Satin Sleepwear",
    price: 599,
    image: "/images/white-bra.jpg",
    badge: "Luxury",
  },
  {
    name: "Comfort Seamless Bra",
    price: 499,
    image: "/images/black-bra.jpg",
    badge: "Popular",
  },
  {
    name: "Black Comfort Bra",
    price: 499,
    image: "/images/nude-bra.jpg",
    badge: "Trending",
  },
  {
    name: "Soft Fit Satin Set",
    price: 699,
    image: "/images/satin-set.jpg",
    badge: "Soft Fit",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AmicUnderwear</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
      }

      body {
        background: #f4f1ef;
        color: #111;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 60px;
        background: white;
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      .logo {
        font-size: 42px;
        font-weight: 900;
      }

      .logo span {
        color: #c79b67;
      }

      .shop-btn {
        background: black;
        color: white;
        border: none;
        padding: 18px 38px;
        border-radius: 999px;
        font-size: 22px;
        font-weight: bold;
        cursor: pointer;
      }

      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        padding: 60px;
        gap: 40px;
      }

      .hero h1 {
        font-size: 90px;
        line-height: 0.95;
        margin-bottom: 20px;
      }

      .hero p {
        font-size: 28px;
        margin-bottom: 30px;
      }

      .hero img {
        width: 100%;
        border-radius: 30px;
      }

      .hero-btn {
        background: black;
        color: white;
        border: none;
        padding: 18px 34px;
        border-radius: 999px;
        font-size: 22px;
        font-weight: bold;
        cursor: pointer;
      }

      .section-title {
        text-align: center;
        font-size: 90px;
        margin: 80px 0 40px;
        font-weight: 900;
      }

      .products {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        padding: 0 40px 100px;
      }

      .card {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        position: relative;
      }

      .card img {
        width: 100%;
        height: 600px;
        object-fit: cover;
      }

      .badge {
        position: absolute;
        top: 20px;
        left: 20px;
        background: white;
        padding: 14px 24px;
        border-radius: 999px;
        font-size: 20px;
        font-weight: bold;
      }

      .card-content {
        padding: 30px;
      }

      .card h3 {
        font-size: 40px;
        margin-bottom: 10px;
      }

      .price {
        color: #c79b67;
        font-size: 60px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .sizes {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
      }

      .size-btn {
        padding: 10px 16px;
        border-radius: 10px;
        border: 1px solid #ccc;
        background: white;
        cursor: pointer;
        font-weight: bold;
      }

      .buy-btn {
        background: black;
        color: white;
        border: none;
        padding: 18px 34px;
        border-radius: 999px;
        font-size: 22px;
        font-weight: bold;
        cursor: pointer;
      }

      .ai-voice-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: black;
        color: white;
        border: none;
        padding: 18px 28px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        z-index: 999;
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .products {
          grid-template-columns: 1fr;
        }

        .hero h1 {
          font-size: 60px;
        }

        .section-title {
          font-size: 60px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <button class="shop-btn">
        Shop Now
      </button>
    </header>

    <section class="hero">
      <div>
        <h1>
          Underwear designed to feel beautiful.
        </h1>

        <p>
          Luxury underwear made for confidence and comfort.
        </p>

        <button class="hero-btn">
          Explore Collection
        </button>
      </div>

      <img src="/images/hero.jpg" alt="Hero" />
    </section>

    <h2 class="section-title">
      Featured Collection
    </h2>

    <section class="products">
      {
        products.map((product) => (
          <div class="card">
            <span class="badge">
              {product.badge}
            </span>

            <img src={product.image} alt={product.name} />

            <div class="card-content">
              <h3>{product.name}</h3>

              <div class="price">
                {product.price} NOK
              </div>

              <div class="sizes">
                <button class="size-btn">XS</button>
                <button class="size-btn">S</button>
                <button class="size-btn">M</button>
                <button class="size-btn">L</button>
                <button class="size-btn">XL</button>
              </div>

              <button
                class="buy-btn"
                onclick={`checkout('${product.name}', ${product.price})`}
              >
                Buy Now
              </button>
            </div>
          </div>
        ))
      }
    </section>

    <button class="ai-voice-btn" onclick="speakAI()">
      🎙 Hear AI Stylist
    </button>

    <script>
      async function checkout(name, price) {
        try {
          const response = await fetch(
            "/api/create-checkout-session",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                name,
                price,
              }),
            }
          );

          const data = await response.json();

          if (data.url) {
            window.location.href = data.url;
          } else {
            alert("Checkout error");
          }
        } catch (error) {
          alert("Something went wrong");
        }
      }

      async function speakAI() {
        const response = await fetch("/api/voice", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            text:
              "Welcome to AmicUnderwear luxury collection.",
          }),
        });

        const blob = await response.blob();

        const audio = new Audio(
          URL.createObjectURL(blob)
        );

        audio.play();
      }
    </script>
  </body>
</html>
