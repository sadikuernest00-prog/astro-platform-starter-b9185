}

];
---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

<title>AmicUnderwear</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f5f5f5;
color:black;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 40px;
background:white;
border-bottom:2px solid #eee;
position:sticky;
top:0;
z-index:100;
}

.logo{
font-size:42px;
font-weight:bold;
}

.logo span{
color:#8a642d;
}

.shop-btn{
background:black;
color:white;
padding:15px 30px;
border-radius:50px;
text-decoration:none;
font-size:20px;
font-weight:bold;
transition:0.3s;
}

.shop-btn:hover{
background:#8a642d;
}

.hero{
height:70vh;
background:url('/images/hero.jpg');
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
position:relative;
padding:20px;
}

.hero::before{
content:"";
position:absolute;
inset:0;
background:rgba(0,0,0,0.4);
}

.hero h1{
position:relative;
color:white;
font-size:64px;
max-width:900px;
}

.section-title{
text-align:center;
font-size:52px;
margin:70px 0 40px;
}

.products{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:30px;
padding:20px 40px 80px;
}

.card{
background:white;
border-radius:30px;
overflow:hidden;
box-shadow:0 5px 20px rgba(0,0,0,0.08);
transition:0.4s;
}

.card:hover{
transform:translateY(-10px);
}

.card img{
width:100%;
height:420px;
object-fit:cover;
}

.card-content{
padding:25px;
}

.card h2{
font-size:30px;
margin-bottom:15px;
}

.price{
font-size:38px;
font-weight:bold;
color:#8a642d;
margin-bottom:20px;
}

.size-label{
font-size:18px;
font-weight:bold;
margin-bottom:10px;
}

.size-select{
width:100%;
padding:14px;
border-radius:14px;
border:2px solid #ddd;
margin-bottom:20px;
font-size:18px;
}

.buy-btn{
display:block;
width:100%;
background:black;
color:white;
padding:18px;
border:none;
border-radius:50px;
font-size:22px;
font-weight:bold;
cursor:pointer;
transition:0.3s;
}

.buy-btn:hover{
background:#8a642d;
}

.ai-box{
background:white;
margin:40px;
padding:40px;
border-radius:30px;
text-align:center;
box-shadow:0 5px 20px rgba(0,0,0,0.08);
}

.ai-box h2{
font-size:48px;
margin-bottom:20px;
}

.ai-text{
font-size:22px;
margin-bottom:30px;
color:#555;
}

.voice-animation{
display:flex;
justify-content:center;
align-items:flex-end;
gap:10px;
height:90px;
margin-bottom:30px;
opacity:0;
transition:0.3s;
}

.voice-animation.active{
opacity:1;
}

.voice-animation span{
width:14px;
height:20px;
background:#8a642d;
border-radius:30px;
animation:voiceWave 1s infinite ease-in-out;
}

.voice-animation span:nth-child(2){
animation-delay:0.1s;
}

.voice-animation span:nth-child(3){
animation-delay:0.2s;
}

.voice-animation span:nth-child(4){
animation-delay:0.3s;
}

.voice-animation span:nth-child(5){
animation-delay:0.4s;
}

.ai-buttons{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.ai-btn{
background:black;
color:white;
border:none;
padding:20px 40px;
border-radius:50px;
font-size:24px;
font-weight:bold;
cursor:pointer;
transition:0.3s;
}

.ai-btn:hover{
background:#8a642d;
}

footer{
background:white;
padding:40px;
text-align:center;
margin-top:60px;
font-size:18px;
}

@keyframes voiceWave{

0%{
height:20px;
}

50%{
height:80px;
}

100%{
height:20px;
}

}

@media(max-width:768px){

.hero h1{
font-size:38px;
}

.section-title{
font-size:36px;
}

.products{
padding:20px;
}

.card img{
height:320px;
}

.ai-box{
margin:20px;
padding:30px 20px;
}

.ai-buttons{
flex-direction:column;
}

}

</style>

</head>

<body>

<header>

<div class="logo">
Amic<span>Underwear</span>
</div>

<a href="#shop" class="shop-btn">
Shop Now
</a>

</header>

<section class="hero">

<h1>
Luxury Underwear Designed For Confidence & Comfort
</h1>

</section>

<h2 class="section-title" id="shop">
Featured Collection
</h2>

<section class="products">

{
products.map((product)=>(

<div class="card">

<img src={product.image} alt={product.name} />

<div class="card-content">

<h2>{product.name}</h2>

<div class="price">
{product.price}
</div>

<div class="size-label">
Select Size
</div>

<select class="size-select">

{
product.sizes.map((size)=>(

<option value={size}>
{size}
</option>

))
}

</select>

<button
class="buy-btn"
onclick={`window.open('${product.link}','_blank')`}
>
Buy Now
</button>

</div>

</div>

))
}

</section>

<section class="ai-box">

<h2>
AI Luxury Stylist
</h2>

<div class="ai-text">
Play our AI luxury assistant voice.
</div>

<div
class="voice-animation"
id="voiceAnimation"
>

<span></span>
<span></span>
<span></span>
<span></span>
<span></span>

</div>

<div class="ai-buttons">

<button
class="ai-btn"
id="playVoiceBtn"
>
▶ Play AI Voice
</button>

<button
class="ai-btn"
id="stopVoiceBtn"
>
■ Stop Voice
</button>

</div>

</section>

<footer>
© 2026 AmicUnderwear
</footer>

<script>

let currentAudio = null;

const playBtn =
document.getElementById("playVoiceBtn");

const stopBtn =
document.getElementById("stopVoiceBtn");

const voiceAnimation =
document.getElementById("voiceAnimation");

playBtn.addEventListener("click", async () => {

try {

playBtn.innerText =
"Loading AI Voice...";

voiceAnimation.classList.add("active");

if(currentAudio){

currentAudio.pause();

currentAudio.currentTime = 0;

}

const response =
await fetch("/api/voice", {

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

text:"Welcome to Amic Underwear. Discover luxury and elegance today."

})

});

if(!response.ok){

const errorText =
await response.text();

alert(errorText);

voiceAnimation.classList.remove("active");

playBtn.innerText =
"▶ Play AI Voice";

return;

}

const blob =
await response.blob();

const audioUrl =
URL.createObjectURL(blob);

currentAudio =
new Audio(audioUrl);

await currentAudio.play();

playBtn.innerText =
"▶ Play AI Voice";

currentAudio.onended = () => {

voiceAnimation.classList.remove("active");

};

} catch(error){

alert("Voice failed");

voiceAnimation.classList.remove("active");

playBtn.innerText =
"▶ Play AI Voice";

}

});

stopBtn.addEventListener("click",()=>{

if(currentAudio){

currentAudio.pause();

currentAudio.currentTime = 0;

}

voiceAnimation.classList.remove("active");

});

</script>

</body>

</html>
