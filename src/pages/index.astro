<title>AmicUnderwear</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, sans-serif;
}

body{
background:#f5f5f5;
color:black;
overflow-x:hidden;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 40px;
background:white;
position:sticky;
top:0;
z-index:100;
border-bottom:2px solid #eee;
backdrop-filter:blur(10px);
}

.logo{
font-size:42px;
font-weight:bold;
animation:fadeDown 1s ease;
}

.logo span{
