---
const products = [
  {
    name: "Elegant Lace Set",
    price: "599 NOK",
    image: "/images/lace-set.jpg",
    badge: "BEST SELLER",
    payment: "https://nowpayments.io/payment/?iid=4680546954&source=button"
  },
  {
    name: "Midnight Black Collection",
    price: "549 NOK",
    image: "/images/black-night.jpg",
    badge: "NEW",
    payment: "https://nowpayments.io/payment/?iid=4680546954&source=button"
  },
  {
    name: "Luxury Sports Bra",
    price: "499 NOK",
    image: "/images/black-sports-bra.jpg",
    badge: "HOT",
    payment: "https://nowpayments.io/payment/?iid=4680546954&source=button"
  },
  {
    name: "White Sports Bra",
    price: "499 NOK",
    image: "/images/white-sports-bra.jpg",
    badge: "TRENDING",
    payment: "https://nowpayments.io/payment/?iid=4680546954&source=button"
  },
  {
    name: "Nude Comfort Bra",
    price: "529 NOK",
    image: "/images/nude-sports-bra.jpg",
    badge: "SOFT",
    payment: "https://nowpayments.io/payment/?iid=4680546954&source=button"
  },
  {
    name: "Luxury Nude Cami",
    price: "579 NOK",
    image: "/images/nude-cami.jpg",
    badge: "LIMITED",
    payment: "https://nowpayments.io/payment/?iid=4680546954&source=button"
  }
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AmicUnderwear</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      background:#f5f5f5;
      color:#111;
    }

    header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:25px 40px;
      background:white;
      position:sticky;
      top:0;
      z-index:100;
      border-bottom:1px solid #eee;
    }

    .logo{
      font-size:55px;
      font-weight:900;
    }

    .logo span{
      color:#c79b5d;
    }

    .shop-btn{
      background:black;
      color:white;
      padding:18px 35px;
      border-radius:50px;
      text-decoration:none;
      font-weight:700;
      font-size:20px;
    }

    .hero{
      padding:100px 20px 70px;
      text-align:center;
    }

    .hero h1{
      font-size:90px;
      font-weight:900;
      line-height:1;
      margin-bottom:25px;
    }

    .hero p{
      font-size:32px;
      color:#666;
      max-width:900px;
      margin:auto;
      line-height:1.5;
    }

    .products{
      width:100%;
      max-width:1700px;
      margin:auto;
      padding:30px;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(420px,1fr));
      gap:35px;
    }

    .card{
      background:white;
      border-radius:35px;
      overflow:hidden;
      box-shadow:0 10px 30px rgba(0,0,0,0.06);
      transition:0.3s;
      position:relative;
    }

    .card:hover{
      transform:translateY(-10px);
    }

    .badge{
      position:absolute;
      top:25px;
      left:25px;
      background:#c79b5d;
      color:white;
      padding:14px 22px;
      border-radius:40px;
      font-weight:700;
      z-index:2;
      font-size:18px;
    }

    .card img{
      width:100%;
      height:700px;
      object-fit:cover;
      background:#ececec;
    }

    .content{
      padding:30px;
    }

    .content h2{
      font-size:55px;
      margin-bottom:20px;
      font-weight:900;
      line-height:1.1;
    }

    .price{
      color:#c79b5d;
      font-size:70px;
      font-weight:900;
      margin-bottom:25px;
    }

    select{
      width:100%;
      padding:20px;
      border-radius:14px;
      border:2px solid #eee;
      margin-bottom:20px;
      font-size:24px;
      font-weight:700;
    }

    .btn{
      width:100%;
      border:none;
      padding:24px;
      border-radius:60px;
      font-size:28px;
      font-weight:900;
      cursor:pointer;
      transition:0.3s;
      margin-top:10px;
    }

    .buy{
      background:black;
      color:white;
    }

    .buy:hover{
      opacity:0.9;
    }

    .ai{
      background:#c79b5d;
      color:white;
    }

    .ai:hover{
      opacity:0.9;
    }

    .trust{
      padding:100px 20px;
      text-align:center;
    }

    .trust h2{
      font-size:60px;
      margin-bottom:50px;
      font-weight:900;
    }

    .trust-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:30px;
      max-width:1400px;
      margin:auto;
    }

    .trust-box{
      background:white;
      padding:40px;
      border-radius:30px;
      box-shadow:0 10px 30px rgba(0,0,0,0.05);
    }

    .trust-box h3{
      font-size:35px;
      margin-bottom:15px;
    }

    .trust-box p{
      color:#666;
      font-size:20px;
      line-height:1.6;
    }

    footer{
      background:black;
      color:white;
      text-align:center;
      padding:50px 20px;
      margin-top:80px;
    }

    footer h2{
      font-size:40px;
      margin-bottom:10px;
    }

    footer p{
      color:#aaa;
      font-size:18px;
    }

    @media(max-width:900px){

      .hero h1{
        font-size:55px;
      }

      .hero p{
        font-size:22px;
      }

      .logo{
        font-size:34px;
      }

      .products{
        grid-template-columns:1fr;
        padding:15px;
      }

      .card img{
        height:500px;
      }

      .content h2{
        font-size:38px;
      }

      .price{
        font-size:48px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="logo">
    Amic<span>Underwear</span>
  </div>

  <a href="#shop" class="shop-btn">
    Shop
  </a>
</header>

<section class="hero">
  <h1>Luxury Underwear Designed For Confidence</h1>

  <p>
    Discover premium comfort, elegant designs and timeless luxury pieces made to feel incredible every day.
  </p>
</section>

<section class="products" id="shop">

  {products.map((product) => (

    <div class="card">

      <div class="badge">
        {product.badge}
      </div>

      <img src={product.image} alt={product.name} />

      <div class="content">

        <h2>{product.name}</h2>

        <div class="price">
          {product.price}
        </div>

        <select>
          <option>XS</option>
          <option>S</option>
          <option>M</option>
          <option>L</option>
          <option>XL</option>
        </select>

        <button
          class="btn buy"
          onclick={`window.open('${product.payment}', '_blank')`}
        >
          Buy With Monero
        </button>

        <button
          class="btn ai"
          onclick={`window.location.href='/generate-model?product=${encodeURIComponent(product.name)}&image=${encodeURIComponent(product.image)}'`}
        >
          Generate AI Model Wearing This
        </button>

      </div>
    </div>

  ))}

</section>

<section class="trust">

  <h2>Why Customers Love AmicUnderwear</h2>

  <div class="trust-grid">

    <div class="trust-box">
      <h3>Premium Quality</h3>
      <p>
        Soft luxury fabrics designed for comfort, elegance and everyday confidence.
      </p>
    </div>

    <div class="trust-box">
      <h3>Fast Worldwide Shipping</h3>
      <p>
        Secure worldwide delivery with premium packaging experience.
      </p>
    </div>

    <div class="trust-box">
      <h3>Luxury Fit</h3>
      <p>
        Designed to shape beautifully while remaining ultra comfortable.
      </p>
    </div>

    <div class="trust-box">
      <h3>Private Checkout</h3>
      <p>
        Pay privately with Monero crypto checkout for secure shopping.
      </p>
    </div>

  </div>

</section>

<footer>

  <h2>AmicUnderwear</h2>

  <p>
    Luxury underwear made for confidence and comfort.
  </p>

</footer>

</body>
</html>
