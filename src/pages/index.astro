---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmicUnderwear</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f3efed;
        color: #111;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 50px;
        background: white;
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      .logo {
        font-size: 54px;
        font-weight: bold;
      }

      .logo span {
        color: #d5a16d;
      }

      .shop-btn {
        background: black;
        color: white;
        padding: 18px 38px;
        border-radius: 999px;
        text-decoration: none;
        font-size: 22px;
        font-weight: bold;
      }

      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 60px;
        padding: 70px 60px;
      }

      .hero h1 {
        font-size: 110px;
        line-height: 0.9;
        margin-bottom: 20px;
      }

      .hero p {
        font-size: 30px;
      }

      .hero-image img {
        width: 100%;
        border-radius: 30px;
      }

      .products {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        padding: 60px;
      }

      .product-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
      }

      .product-card img {
        width: 100%;
        height: 550px;
        object-fit: cover;
      }

      .product-content {
        padding: 24px;
      }

      .product-content h2 {
        font-size: 38px;
        margin-bottom: 12px;
      }

      .price {
        font-size: 42px;
        font-weight: bold;
        color: #d5a16d;
        margin-bottom: 24px;
      }

      .buy-button {
        background: black;
        color: white;
        border: none;
        padding: 16px 34px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .products {
          grid-template-columns: 1fr;
        }

        .hero h1 {
          font-size: 60px;
        }
      }
    </style>
  </head>

  <body>

    <header>
      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <a href="#products" class="shop-btn">
        Shop Now
      </a>
    </header>

    <section class="hero">
      <div>
        <h1>
          Underwear designed to feel beautiful.
        </h1>

        <p>
          Luxury underwear made for confidence and comfort.
        </p>
      </div>

      <div class="hero-image">
        <img
          src="https://images.unsplash.com/photo-1581044777550-4cfa60707c03?q=80&w=1200&auto=format&fit=crop"
          alt=""
        />
      </div>
    </section>

    <section class="products" id="products">

      <!-- PRODUCT 1 -->
      <div class="product-card">
        <img
          src="https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?q=80&w=1200&auto=format&fit=crop"
          alt=""
        />

        <div class="product-content">
          <h2>Elegant Lace Set</h2>

          <div class="price">599 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="599" />

            <button class="buy-button" type="submit">
              Buy Now
            </button>
          </form>
        </div>
      </div>

      <!-- PRODUCT 2 -->
      <div class="product-card">
        <img
          src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=1200&auto=format&fit=crop"
          alt=""
        />

        <div class="product-content">
          <h2>Midnight Black Collection</h2>

          <div class="price">549 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="549" />

            <button class="buy-button" type="submit">
              Buy Now
            </button>
          </form>
        </div>
      </div>

      <!-- PRODUCT 3 -->
      <div class="product-card">
        <img
          src="https://images.unsplash.com/photo-1617331721458-bd3bd3f9c7f8?q=80&w=1200&auto=format&fit=crop"
          alt=""
        />

        <div class="product-content">
          <h2>Luxury Satin Sleepwear</h2>

          <div class="price">599 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="599" />

            <button class="buy-button" type="submit">
              Buy Now
            </button>
          </form>
        </div>
      </div>

    </section>

  </body>
</html>
