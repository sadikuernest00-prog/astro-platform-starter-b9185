---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmicUnderwear</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f4f1ef;
        color: #111;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: white;
        padding: 24px 50px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-size: 58px;
        font-weight: 800;
      }

      .logo span {
        color: #d6a36c;
      }

      .shop-btn {
        background: black;
        color: white;
        padding: 18px 40px;
        border-radius: 999px;
        text-decoration: none;
        font-size: 24px;
        font-weight: bold;
      }

      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        padding: 80px 60px;
        gap: 50px;
      }

      .hero h1 {
        font-size: 110px;
        line-height: 0.9;
        margin-bottom: 25px;
      }

      .hero p {
        font-size: 30px;
        margin-bottom: 30px;
      }

      .hero-button {
        background: black;
        color: white;
        border: none;
        padding: 18px 40px;
        border-radius: 999px;
        font-size: 24px;
        font-weight: bold;
      }

      .hero img {
        width: 100%;
        border-radius: 30px;
      }

      .featured-title {
        text-align: center;
        font-size: 96px;
        font-weight: 900;
        margin-bottom: 50px;
      }

      .products {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        padding: 0 60px 80px;
      }

      .card {
        background: white;
        border-radius: 25px;
        overflow: hidden;
      }

      .image-wrapper {
        position: relative;
      }

      .tag {
        position: absolute;
        top: 20px;
        left: 20px;
        background: white;
        padding: 14px 24px;
        border-radius: 999px;
        font-size: 20px;
        font-weight: bold;
      }

      .card img {
        width: 100%;
        height: 650px;
        object-fit: cover;
      }

      .card-content {
        padding: 28px;
      }

      .card-content h2 {
        font-size: 28px;
        margin-bottom: 16px;
      }

      .price {
        font-size: 42px;
        font-weight: bold;
        color: #d6a36c;
        margin-bottom: 20px;
      }

      .buy-button {
        background: black;
        color: white;
        border: none;
        padding: 16px 34px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .products {
          grid-template-columns: 1fr;
        }

        .hero h1 {
          font-size: 60px;
        }

        .featured-title {
          font-size: 52px;
        }
      }
    </style>
  </head>

  <body>

    <header>
      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <a href="#products" class="shop-btn">
        Shop Now
      </a>
    </header>

    <section class="hero">
      <div>
        <h1>
          Underwear designed to feel beautiful.
        </h1>

        <p>
          Luxury underwear made for confidence and comfort.
        </p>

        <button class="hero-button">
          Explore Collection
        </button>
      </div>

      <img
        src="https://images.unsplash.com/photo-1581044777550-4cfa60707c03?q=80&w=1200&auto=format&fit=crop"
        alt=""
      />
    </section>

    <h2 class="featured-title">
      Featured Collection
    </h2>

    <section class="products" id="products">

      <!-- PRODUCT 1 -->
      <div class="card">
        <div class="image-wrapper">
          <div class="tag">Best Seller</div>

          <img
            src="https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?q=80&w=1200&auto=format&fit=crop"
            alt=""
          />
        </div>

        <div class="card-content">
          <h2>Elegant Lace Set</h2>

          <div class="price">599 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="599" />
            <input type="hidden" name="product" value="Elegant Lace Set" />

            <button class="buy-button" type="submit">
              Buy Now
            </button>
          </form>
        </div>
      </div>

      <!-- PRODUCT 2 -->
      <div class="card">
        <div class="image-wrapper">
          <div class="tag">New</div>

          <img
            src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=1200&auto=format&fit=crop"
            alt=""
          />
        </div>

        <div class="card-content">
          <h2>Midnight Black Collection</h2>

          <div class="price">549 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="549" />
            <input type="hidden" name="product" value="Midnight Black Collection" />

            <button class="buy-button" type="submit">
              Buy Now
            </button>
          </form>
        </div>
      </div>

      <!-- PRODUCT 3 -->
      <div class="card">
        <div class="image-wrapper">
          <div class="tag">Luxury</div>

          <img
            src="https://images.unsplash.com/photo-1617331721458-bd3bd3f9c7f8?q=80&w=1200&auto=format&fit=crop"
            alt=""
          />
        </div>

        <div class="card-content">
          <h2>Luxury Satin Sleepwear</h2>

          <div class="price">599 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="599" />
            <input type="hidden" name="product" value="Luxury Satin Sleepwear" />

            <button class="buy-button" type="submit">
              Buy Now
            </button>
          </form>
        </div>
      </div>

    </section>

  </body>
</html>
