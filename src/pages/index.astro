---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AmicBridge Pro | Forex Education, Insights & Tools</title>
    <meta
      name="description"
      content="AmicBridge helps you earn money on your investment at amicbridge start white what ever amount you want start big or small we provide you trust by making your moeny work for you "
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <div class="brand-wrap">
          <a href="/" class="logo">
            <span class="logo-dark">AMIC</span><span class="logo-blue">BRIDGE</span>
          </a>
          <p class="tagline">Forex education, market insights, and trading tools</p>
        </div>

        <nav class="menu">
          <a href="#offer">Offer</a>
          <a href="#features">Features</a>
          <a href="#pricing">Pricing</a>
          <a href="#faq">FAQ</a>
        </nav>

        <a href="#pricing" class="nav-btn">Get Access</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-left">
            <div class="pill">PREMIUM FOREX MEMBERSHIP</div>

            <h1>
              Learn Forex.<br />
              Analyze Better.<br />
              Earn Smarter.
            </h1>

            <p class="hero-text">
              AmicBridge helps you earn money on your investment at amicbridge start white what ever amount you want start big or small we provide you trust by making your moeny work for you "
    />            </p>

            <ul class="hero-list">
              <li><span>📊</span> Premium market insights and trade ideas</li>
              <li><span>📚</span> Structured forex education for all levels</li>
              <li><span>🛠️</span> Risk, planning, and trading tools</li>
              <li><span>🎯</span> Practical guidance to help you trade with more clarity</li>
            </ul>

            <div class="hero-actions">
              <a href="#pricing" class="btn btn-primary">Join for $499</a>
              <a href="#features" class="btn btn-secondary">See What You Get</a>
            </div>

            <div class="mini-proof">
              <div class="proof-box">
                <strong>Education</strong>
                <span>Clear lessons and frameworks</span>
              </div>
              <div class="proof-box">
                <strong>Insights</strong>
                <span>See what matters in the market</span>
              </div>
              <div class="proof-box">
                <strong>Execution</strong>
                <span>You stay in control of every trade</span>
              </div>
            </div>
          </div>

          <div class="hero-right">
            <div class="card pricing-card">
              <div class="card-badge">AMICBRIDGE PRO</div>
              <div class="price-row">
                <span class="price">$499</span>
                <span class="price-note">one-time access</span>
              </div>

              <p class="price-copy">
                Pay once and get access to premium tools, educational resources,
                market analysis, and structured trade ideas that help you improve
                your trading and work toward making money more consistently.
              </p>

              <ul class="card-list">
                <li>Weekly market breakdowns</li>
                <li>Trade setup ideas</li>
                <li>Risk management tools</li>
                <li>Members-only resources</li>
                <li>Premium learning content</li>
              </ul>

              <a href="#pricing" class="btn btn-primary full">Get Premium Access</a>
            </div>

            <div class="card trust-card">
              <div class="trust-head">
                <span class="trust-icon">⚠️</span>
                <h3>Important</h3>
              </div>
              <p>
                AmicBridge helps you learn, analyze, and improve your ability to
                make money through your own trading decisions. We provide education,
                insights, and tools — you remain responsible for your own trades.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="offer" class="section section-soft">
        <div class="container">
          <div class="section-heading">
            <span class="section-pill">WHY PEOPLE JOIN</span>
            <h2>Built to help traders improve results</h2>
            <p>
              AmicBridge is designed for people who want more than random signals.
              We help you understand the market, spot opportunities, and build a
              stronger process that can help you make money with more structure.
            </p>
          </div>

          <div class="offer-grid">
            <div class="offer-card">
              <div class="offer-icon">🔍</div>
              <h3>Understand the Market</h3>
              <p>
                Learn how price moves, what drives currency pairs, and how to
                read the market with more confidence.
              </p>
            </div>

            <div class="offer-card">
              <div class="offer-icon">📈</div>
              <h3>Find Better Setups</h3>
              <p>
                Use insights and frameworks that help you identify stronger
                trade opportunities.
              </p>
            </div>

            <div class="offer-card">
              <div class="offer-icon">🧠</div>
              <h3>Make Smarter Decisions</h3>
              <p>
                Reduce guesswork and improve discipline with clearer planning
                and better execution habits.
              </p>
            </div>

            <div class="offer-card">
              <div class="offer-icon">💰</div>
              <h3>Work Toward Profitability</h3>
              <p>
                Our goal is to help you build the skills, knowledge, and
                structure needed to improve your trading outcomes over time.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="section">
        <div class="container">
          <div class="section-heading">
            <span class="section-pill">WHAT YOU GET</span>
            <h2>Everything inside AmicBridge Pro</h2>
          </div>

          <div class="features-grid">
            <div class="feature-card">
              <div class="feature-top">📚</div>
              <h3>Forex Education</h3>
              <p>
                Foundations, technical analysis, risk management, and market structure.
              </p>
            </div>

            <div class="feature-card">
              <div class="feature-top">📊</div>
              <h3>Market Insights</h3>
              <p>
                Clear breakdowns of important market movement, trends, and potential setups.
              </p>
            </div>

            <div class="feature-card">
              <div class="feature-top">🛠️</div>
              <h3>Trading Tools</h3>
              <p>
                Use calculators, planning resources, and trading aids to support execution.
              </p>
            </div>

            <div class="feature-card">
              <div class="feature-top">🎯</div>
              <h3>Trade Ideas</h3>
              <p>
                Structured ideas that help you understand possible opportunities and scenarios.
              </p>
            </div>

            <div class="feature-card">
              <div class="feature-top">🧭</div>
              <h3>Trading Frameworks</h3>
              <p>
                Get more clarity on how to approach entries, exits, and risk with discipline.
              </p>
            </div>

            <div class="feature-card">
              <div class="feature-top">🚀</div>
              <h3>Premium Access</h3>
              <p>
                One payment unlocks premium content designed to help you trade with more confidence.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="pricing" class="section section-soft">
        <div class="container">
          <div class="pricing-wrap">
            <div class="pricing-left">
              <span class="section-pill">PRICING</span>
              <h2>One premium plan. One clear goal.</h2>
              <p>
                Join AmicBridge Pro for <strong>$499</strong> and get premium access
                to the education, tools, and market insights that help you improve
                your trading and move toward better results.
              </p>

              <ul class="pricing-points">
                <li>Premium forex learning library</li>
                <li>Trade ideas and market breakdowns</li>
                <li>Trading tools and resources</li>
                <li>Structured support for better decisions</li>
              </ul>
            </div>

            <div class="pricing-right">
              <div class="checkout-card">
                <div class="checkout-top">AMICBRIDGE PRO ACCESS</div>
                <div class="checkout-price">$499</div>
                <p>
                  Premium membership focused on helping you build the knowledge
                  and structure to trade better and improve your ability to make money.
                </p>
                <a href="#faq" class="btn btn-primary full">Get Started Today</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="faq" class="section">
        <div class="container">
          <div class="section-heading">
            <span class="section-pill">FAQ</span>
            <h2>Common questions</h2>
          </div>

          <div class="faq-grid">
            <div class="faq-item">
              <h3>What do I get after payment?</h3>
              <p>
                You get access to premium forex education, tools, trade ideas,
                and market insights designed to help you trade better.
              </p>
            </div>

            <div class="faq-item">
              <h3>Can AmicBridge help me make money?</h3>
              <p>
                AmicBridge is built to help you improve your trading decisions,
                identify stronger opportunities, and work toward better results.
              </p>
            </div>

            <div class="faq-item">
              <h3>Who places the trades?</h3>
              <p>
                You do. AmicBridge provides support through education, tools,
                and market analysis to help guide your decisions.
              </p>
            </div>

            <div class="faq-item">
              <h3>Who is this for?</h3>
              <p>
                Beginners, developing traders, and anyone who wants a more
                structured approach to forex.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          AmicBridge provides educational content, market insights, and trading
          tools. Trading involves risk, and outcomes are never guaranteed.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #f3f6fb;
    --surface: #ffffff;
    --surface-soft: #eef4ff;
    --surface-soft-2: #f7f9fd;
    --text: #121826;
    --muted: #667085;
    --border: #dde5ef;
    --primary: #2948a3;
    --primary-dark: #1f397f;
    --shadow: 0 12px 30px rgba(17, 24, 39, 0.06);
    --radius: 24px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: var(--text);
    background: var(--bg);
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .container {
    width: min(1280px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  .logo-dark {
    color: var(--text);
  }

  .logo-blue {
    color: var(--primary);
  }

  .tagline {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .menu {
    display: flex;
    gap: 30px;
    align-items: center;
    font-weight: 600;
  }

  .menu a:hover {
    color: var(--primary);
  }

  .nav-btn,
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    font-weight: 800;
    transition: 0.2s ease;
  }

  .nav-btn {
    background: var(--primary);
    color: #fff;
    padding: 14px 22px;
  }

  .nav-btn:hover,
  .btn-primary:hover {
    background: var(--primary-dark);
  }

  .hero {
    padding: 72px 0 34px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 46px;
    align-items: start;
  }

  .pill,
  .section-pill,
  .card-badge {
    display: inline-flex;
    align-items: center;
    background: #dcebff;
    color: #0f66a8;
    border-radius: 999px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .pill {
    padding: 10px 16px;
    margin-bottom: 22px;
    font-size: 0.9rem;
  }

  .section-pill {
    padding: 8px 14px;
    font-size: 0.8rem;
    margin-bottom: 14px;
  }

  h1 {
    margin: 0 0 20px;
    font-size: clamp(3.1rem, 6vw, 5.3rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .hero-text {
    margin: 0 0 26px;
    max-width: 700px;
    font-size: 1.32rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .hero-list {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: grid;
    gap: 14px;
  }

  .hero-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 1.08rem;
    color: #435065;
  }

  .hero-list span {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #ecf2ff;
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  .btn {
    min-height: 56px;
    padding: 0 26px;
  }

  .btn-primary {
    background: var(--primary);
    color: #fff;
  }

  .btn-secondary {
    background: #fff;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: #c5cfdb;
  }

  .mini-proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .proof-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 16px;
    box-shadow: var(--shadow);
  }

  .proof-box strong {
    display: block;
    margin-bottom: 6px;
    font-size: 1rem;
  }

  .proof-box span {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .card,
  .offer-card,
  .feature-card,
  .checkout-card,
  .faq-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .pricing-card,
  .trust-card {
    padding: 28px;
  }

  .price-row {
    display: flex;
    align-items: end;
    gap: 10px;
    margin: 16px 0 12px;
  }

  .price {
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
  }

  .price-note {
    color: var(--muted);
    margin-bottom: 8px;
    font-size: 1rem;
  }

  .price-copy {
    color: var(--muted);
    line-height: 1.7;
    font-size: 1.02rem;
    margin-bottom: 18px;
  }

  .card-list {
    margin: 0 0 24px;
    padding-left: 18px;
    color: var(--muted);
    line-height: 1.8;
  }

  .full {
    width: 100%;
  }

  .trust-card {
    background: var(--surface-soft);
  }

  .trust-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .trust-head h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  .trust-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .section {
    padding: 36px 0 72px;
  }

  .section-soft {
    background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.35) 100%);
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 28px;
  }

  .section-heading h2 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.05;
  }

  .section-heading p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .offer-grid,
  .features-grid,
  .faq-grid {
    display: grid;
    gap: 20px;
  }

  .offer-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .features-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .faq-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .offer-card,
  .feature-card,
  .faq-item {
    padding: 24px;
  }

  .offer-icon,
  .feature-top {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ecf2ff;
    font-size: 1.5rem;
    margin-bottom: 16px;
  }

  .offer-card h3,
  .feature-card h3,
  .faq-item h3 {
    margin: 0 0 10px;
    font-size: 1.25rem;
  }

  .offer-card p,
  .feature-card p,
  .faq-item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .pricing-wrap {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 24px;
    align-items: center;
  }

  .pricing-left h2 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 3vw, 2.8rem);
  }

  .pricing-left p {
    margin: 0 0 20px;
    color: var(--muted);
    line-height: 1.75;
    font-size: 1.06rem;
    max-width: 700px;
  }

  .pricing-points {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
    line-height: 1.9;
  }

  .checkout-card {
    padding: 30px;
    text-align: left;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  }

  .checkout-top {
    color: var(--primary);
    font-weight: 900;
    letter-spacing: 0.08em;
    font-size: 0.9rem;
    margin-bottom: 10px;
  }

  .checkout-price {
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 12px;
  }

  .checkout-card p {
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 22px;
  }

  .site-footer {
    background: #fff;
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    padding: 24px 0 32px;
  }

  .footer-inner p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  @media (max-width: 1100px) {
    .hero-grid,
    .pricing-wrap,
    .offer-grid,
    .features-grid,
    .faq-grid,
    .mini-proof {
      grid-template-columns: 1fr 1fr;
    }

    .offer-grid,
    .features-grid,
    .faq-grid {
      gap: 16px;
    }

    .hero-grid,
    .pricing-wrap {
      gap: 28px;
    }
  }

  @media (max-width: 860px) {
    .menu {
      display: none;
    }

    .hero-grid,
    .pricing-wrap,
    .offer-grid,
    .features-grid,
    .faq-grid,
    .mini-proof {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 48px;
    }

    .price,
    .checkout-price {
      font-size: 3.2rem;
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(1280px, calc(100% - 24px));
    }

    .logo {
      font-size: 1.6rem;
    }

    .tagline {
      font-size: 0.88rem;
    }

    .hero-text {
      font-size: 1.08rem;
    }

    .btn,
    .nav-btn {
      width: 100%;
    }

    .pricing-card,
    .trust-card,
    .offer-card,
    .feature-card,
    .checkout-card,
    .faq-item {
      padding: 20px;
    }
  }
</style>
