---
const products = [
  {
    name: "Elegant Lace Set",
    price: "599 NOK",
    image: "/images/white-lace.jpg",
    badge: "Best Seller",
  },
  {
    name: "Midnight Black Collection",
    price: "549 NOK",
    image: "/images/black-set.jpg",
    badge: "New",
  },
  {
    name: "Luxury Satin Sleepwear",
    price: "599 NOK",
    image: "/images/satin-set.jpg",
    badge: "Luxury",
  },
  {
    name: "Comfort Seamless Bra",
    price: "399 NOK",
    image: "/images/white-bra.jpg",
    badge: "Popular",
  },
  {
    name: "Black Comfort Bra",
    price: "399 NOK",
    image: "/images/black-bra.jpg",
    badge: "Trending",
  },
  {
    name: "Soft Fit Collection",
    price: "449 NOK",
    image: "/images/nude-bra.jpg",
    badge: "Soft Fit",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AmicUnderwear</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #ece8e5;
        color: #111;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 5%;
        background: white;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .logo {
        font-size: 48px;
        font-weight: 900;
      }

      .logo span {
        color: #c89a61;
      }

      .shop-btn {
        background: black;
        color: white;
        border: none;
        padding: 16px 34px;
        border-radius: 50px;
        font-size: 22px;
        font-weight: bold;
        cursor: pointer;
      }

      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        padding: 60px 5%;
        gap: 40px;
      }

      .hero-text h1 {
        font-size: 90px;
        line-height: 0.95;
        margin-bottom: 20px;
      }

      .hero-text p {
        font-size: 24px;
        margin-bottom: 30px;
      }

      .hero-text button {
        background: black;
        color: white;
        border: none;
        padding: 18px 40px;
        border-radius: 50px;
        font-size: 22px;
        cursor: pointer;
        font-weight: bold;
      }

      .hero img {
        width: 100%;
        border-radius: 30px;
      }

      .section-title {
        text-align: center;
        font-size: 72px;
        margin: 60px 0;
        font-weight: 900;
      }

      .products {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        padding: 0 5% 100px;
      }

      .card {
        background: #f5f5f5;
        border-radius: 30px;
        overflow: hidden;
      }

      .card-image {
        position: relative;
      }

      .card-image img {
        width: 100%;
        height: 500px;
        object-fit: cover;
      }

      .badge {
        position: absolute;
        top: 20px;
        left: 20px;
        background: white;
        padding: 10px 20px;
        border-radius: 40px;
        font-weight: bold;
        font-size: 20px;
      }

      .card-content {
        padding: 30px;
      }

      .card-content h2 {
        font-size: 36px;
        margin-bottom: 15px;
      }

      .price {
        color: #c89a61;
        font-size: 46px;
        font-weight: bold;
        margin-bottom: 20px;
      }

      select {
        width: 100%;
        padding: 16px;
        font-size: 18px;
        margin-bottom: 20px;
        border-radius: 12px;
        border: 1px solid #ccc;
      }

      .buy-btn {
        width: 100%;
        background: black;
        color: white;
        border: none;
        padding: 18px;
        border-radius: 50px;
        font-size: 24px;
        cursor: pointer;
        font-weight: bold;
      }

      .buy-btn:hover {
        opacity: 0.9;
      }

      .ai-section {
        text-align: center;
        padding-bottom: 100px;
      }

      .ai-btn {
        background: #c89a61;
        color: white;
        border: none;
        padding: 22px 45px;
        font-size: 24px;
        border-radius: 50px;
        cursor: pointer;
        font-weight: bold;
      }

      footer {
        text-align: center;
        padding: 40px;
        font-size: 18px;
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .products {
          grid-template-columns: 1fr;
        }

        .hero-text h1 {
          font-size: 56px;
        }

        .section-title {
          font-size: 48px;
        }

        .logo {
          font-size: 32px;
        }

        .card-image img {
          height: 420px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <button class="shop-btn">
        Shop Now
      </button>
    </header>

    <section class="hero">
      <div class="hero-text">
        <h1>
          Underwear designed to feel beautiful.
        </h1>

        <p>
          Luxury underwear made for confidence and comfort.
        </p>

        <button>
          Explore Collection
        </button>
      </div>

      <img src="/images/hero.jpg" alt="Hero" />
    </section>

    <h2 class="section-title">
      Featured Collection
    </h2>

    <section class="products">
      {
        products.map((product) => (
          <div class="card">
            <div class="card-image">
              <img src={product.image} alt={product.name} />
              <div class="badge">{product.badge}</div>
            </div>

            <div class="card-content">
              <h2>{product.name}</h2>

              <div class="price">
                {product.price}
              </div>

              <select>
                <option>Select Size</option>
                <option>XS</option>
                <option>S</option>
                <option>M</option>
                <option>L</option>
                <option>XL</option>
              </select>

              <button
                class="buy-btn"
                onclick={`window.location.href='https://buy.stripe.com/test_4gM3cu2ZNcKjdG423z7Re01'`}
              >
                Buy Now
              </button>
            </div>
          </div>
        ))
      }
    </section>

    <section class="ai-section">
      <button class="ai-btn" id="voiceBtn">
        🎙 Hear AI Stylist
      </button>
    </section>

    <footer>
      © 2026 AmicUnderwear — Luxury & Comfort
    </footer>

    <script>
      const btn = document.getElementById("voiceBtn");

      btn.addEventListener("click", async () => {
        try {
          const response = await fetch("/api/voice", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              text:
                "Welcome to Amic Underwear. Discover luxury fashion, comfort, and elegance made for you.",
            }),
          });

          const blob = await response.blob();

          const url = URL.createObjectURL(blob);

          const audio = new Audio(url);

          audio.play();
        } catch (err) {
          alert("AI voice failed");
        }
      });
    </script>
  </body>
</html>
