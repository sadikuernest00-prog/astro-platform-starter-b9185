}

.shop-btn:hover{
background:#b88b4a;
transform:scale(1.05);
}

.hero{
height:70vh;
background-image:url('/images/hero.jpg');
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
