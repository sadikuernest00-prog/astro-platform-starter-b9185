---
const products = [
  {
    name: "Elegant Lace Set",
    price: 599,
    image: "/images/white-lace.jpg",
    badge: "Best Seller"
  },
  {
    name: "Midnight Black Collection",
    price: 549,
    image: "/images/black-set.jpg",
    badge: "New"
  },
  {
    name: "Luxury Satin Sleepwear",
    price: 599,
    image: "/images/white-bra.jpg",
    badge: "Luxury"
  },
  {
    name: "Comfort Seamless Bra",
    price: 399,
    image: "/images/black-bra.jpg",
    badge: "Popular"
  },
  {
    name: "Black Comfort Bra",
    price: 399,
    image: "/images/nude-bra.jpg",
    badge: "Trending"
  },
  {
    name: "Soft Fit Satin Set",
    price: 699,
    image: "/images/satin-set.jpg",
    badge: "Soft Fit"
  }
];
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>AmicUnderwear</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#ece8e6;
color:#000;
}

nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:30px 60px;
background:#fff;
position:sticky;
top:0;
z-index:1000;
}

.logo{
font-size:60px;
font-weight:900;
}

.logo span{
color:#d8a56c;
}

.shop-btn{
background:black;
color:white;
border:none;
padding:20px 40px;
border-radius:50px;
font-size:26px;
font-weight:700;
cursor:pointer;
}

.hero{
display:grid;
grid-template-columns:1fr 1fr;
gap:60px;
align-items:center;
padding:80px 60px;
}

.hero h1{
font-size:120px;
line-height:0.9;
margin-bottom:30px;
}

.hero p{
font-size:30px;
margin-bottom:30px;
}

.hero-button{
background:black;
color:white;
border:none;
padding:20px 40px;
border-radius:50px;
font-size:28px;
font-weight:700;
cursor:pointer;
}

.hero img{
width:100%;
border-radius:40px;
}

.section-title{
font-size:110px;
font-weight:900;
text-align:center;
margin:50px 0;
}

.products{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:40px;
padding:40px;
}

.card{
background:white;
border-radius:40px;
overflow:hidden;
}

.card-image{
position:relative;
}

.card-image img{
width:100%;
height:650px;
object-fit:cover;
display:block;
}

.badge{
position:absolute;
top:25px;
left:25px;
background:white;
padding:14px 22px;
border-radius:40px;
font-size:24px;
font-weight:700;
}

.card-content{
padding:30px;
}

.card h2{
font-size:48px;
line-height:1.1;
margin-bottom:20px;
}

.price{
font-size:70px;
font-weight:900;
color:#d8a56c;
margin-bottom:25px;
}

.buy-btn{
background:black;
color:white;
border:none;
padding:18px 38px;
border-radius:50px;
font-size:28px;
font-weight:700;
cursor:pointer;
}

@media(max-width:1100px){

.hero{
grid-template-columns:1fr;
}

.products{
grid-template-columns:1fr;
}

.hero h1{
font-size:70px;
}

.section-title{
font-size:60px;
}

.logo{
font-size:38px;
}

}

</style>

</head>

<body>

<nav>

<div class="logo">
Amic<span>Underwear</span>
</div>

<button class="shop-btn">
Shop Now
</button>

</nav>

<section class="hero">

<div>

<h1>
Underwear designed to feel beautiful.
</h1>

<p>
Luxury underwear made for confidence and comfort.
</p>

<button class="hero-button">
Explore Collection
</button>

</div>

<img src="/images/hero.jpg" alt="Hero"/>

</section>

<h1 class="section-title">
Featured Collection
</h1>

<section class="products">

{
products.map((product) => (

<div class="card">

<div class="card-image">

<img src={product.image} alt={product.name} />

<div class="badge">
{product.badge}
</div>

</div>

<div class="card-content">

<h2>
{product.name}
</h2>

<div class="price">
{product.price} NOK
</div>

<button
class="buy-btn"
data-name={product.name}
data-price={product.price}
>
Buy Now
</button>

</div>

</div>

))
}

</section>

<script>

const buttons = document.querySelectorAll('.buy-btn');

buttons.forEach((button) => {

button.addEventListener('click', async () => {

const name = button.dataset.name;
const price = button.dataset.price;

try {

const response = await fetch('/api/create-checkout-session', {

method:'POST',

headers:{
'Content-Type':'application/json'
},

body:JSON.stringify({
name,
price
})

});

const data = await response.json();

if(data.url){

window.location.href = data.url;

}else{

alert('Stripe checkout failed');

}

}catch(error){

console.error(error);
alert('Checkout error');

}

});

});

</script>

</body>
</html>
