---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

<title>AmicUnderwear</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#f5f5f5;
color:#111;
overflow-x:hidden;
}

/* HEADER */

header{
position:fixed;
top:0;
left:0;
width:100%;
padding:20px 50px;
display:flex;
justify-content:space-between;
align-items:center;
background:rgba(255,255,255,0.88);
backdrop-filter:blur(15px);
z-index:999;
border-bottom:1px solid rgba(0,0,0,0.05);
}

.logo{
font-size:48px;
font-weight:800;
}

.logo span{
color:#b58a56;
}

.nav-btn{
background:black;
color:white;
padding:16px 34px;
border-radius:100px;
text-decoration:none;
font-weight:700;
font-size:18px;
transition:0.3s;
}

.nav-btn:hover{
transform:scale(1.05);
}

/* HERO */

.hero{
height:100vh;
position:relative;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
overflow:hidden;
}

.hero::before{

content:"";

position:absolute;
inset:0;

background:
linear-gradient(rgba(0,0,0,0.45),rgba(0,0,0,0.45)),
url('/images/hero.jpg');

background-size:cover;
background-position:center;

}

.hero-content{
position:relative;
z-index:2;
padding:20px;
max-width:1000px;
}

.hero h1{
font-size:92px;
line-height:1;
font-weight:800;
color:white;
margin-bottom:30px;
}

.hero p{
font-size:24px;
color:#ddd;
max-width:700px;
margin:auto;
margin-bottom:40px;
line-height:1.6;
}

.hero-buttons{
display:flex;
gap:20px;
justify-content:center;
flex-wrap:wrap;
}

.hero-btn{
padding:20px 42px;
border-radius:100px;
font-size:20px;
font-weight:700;
text-decoration:none;
transition:0.3s;
}

.primary-btn{
background:#b58a56;
color:white;
}

.secondary-btn{
background:white;
color:black;
}

.hero-btn:hover{
transform:translateY(-4px);
}

/* TRUST */

.trust-bar{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
padding:50px;
background:white;
}

.trust-card{
text-align:center;
padding:25px;
border-radius:25px;
background:#fafafa;
}

.trust-card h3{
font-size:22px;
margin-bottom:10px;
}

.trust-card p{
color:#666;
font-size:16px;
}

/* TITLES */

.section-title{
text-align:center;
font-size:64px;
margin:100px 0 20px;
font-weight:800;
}

.section-text{
text-align:center;
max-width:700px;
margin:auto;
font-size:22px;
color:#666;
line-height:1.6;
margin-bottom:60px;
}

/* PRODUCTS */

.products{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(340px,1fr));

gap:35px;

padding:0 50px 120px;
}

.card{
background:white;
border-radius:35px;
overflow:hidden;
box-shadow:0 12px 35px rgba(0,0,0,0.08);
transition:0.4s;
position:relative;
}

.card:hover{
transform:translateY(-10px);
}

.badge{
position:absolute;
top:22px;
left:22px;
background:#b58a56;
color:white;
padding:12px 20px;
border-radius:100px;
font-size:14px;
font-weight:700;
z-index:2;
}

.card img{
width:100%;
height:520px;
object-fit:cover;
background:#eee;
}

.card-content{
padding:30px;
}

.card h2{
font-size:38px;
margin-bottom:15px;
line-height:1.1;
}

.description{
font-size:18px;
line-height:1.6;
color:#666;
margin-bottom:25px;
}

.price-row{
display:flex;
align-items:center;
gap:15px;
margin-bottom:25px;
}

.price{
font-size:46px;
font-weight:800;
color:#b58a56;
}

.old-price{
font-size:24px;
text-decoration:line-through;
color:#999;
}

.size-select{
width:100%;
padding:16px;
border-radius:18px;
border:2px solid #eee;
margin-bottom:20px;
font-size:18px;
background:white;
}

.buy-btn{
width:100%;
background:black;
color:white;
padding:20px;
border:none;
border-radius:100px;
font-size:22px;
font-weight:700;
cursor:pointer;
margin-bottom:15px;
transition:0.3s;
}

.ai-product-btn{
width:100%;
background:#b58a56;
color:white;
padding:18px;
border:none;
border-radius:100px;
font-size:20px;
font-weight:700;
cursor:pointer;
transition:0.3s;
}

.buy-btn:hover,
.ai-product-btn:hover{
transform:translateY(-3px);
}

/* AI GENERATOR */

.model-generator{
padding:40px 20px 120px;
text-align:center;
}

.generator-title{
font-size:72px;
margin-bottom:20px;
font-weight:800;
}

.generator-text{
font-size:24px;
color:#666;
margin-bottom:40px;
}

.loading{
display:none;
font-size:26px;
font-weight:700;
margin-top:20px;
}

.generated-image{
display:none;
margin:60px auto;
max-width:700px;
width:100%;
border-radius:35px;
box-shadow:0 15px 50px rgba(0,0,0,0.18);
}

/* REVIEWS */

.reviews{
padding:60px 50px 120px;
}

.reviews-grid{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(300px,1fr));

gap:30px;
}

.review-card{
background:white;
padding:35px;
border-radius:30px;
box-shadow:0 10px 30px rgba(0,0,0,0.08);
}

.stars{
font-size:28px;
color:#b58a56;
margin-bottom:20px;
}

.review-text{
font-size:21px;
line-height:1.7;
margin-bottom:20px;
color:#444;
}

.review-user{
font-size:18px;
font-weight:700;
}

/* FOOTER */

footer{
padding:60px;
text-align:center;
background:white;
font-size:18px;
color:#666;
}

/* MOBILE */

@media(max-width:768px){

header{
padding:20px;
}

.logo{
font-size:34px;
}

.hero h1{
font-size:52px;
}

.hero p{
font-size:20px;
}

.section-title{
font-size:42px;
}

.products{
padding:20px;
}

.card img{
height:420px;
}

.generator-title{
font-size:44px;
}

}

</style>

</head>

<body>

<header>

<div class="logo">
Amic<span>Underwear</span>
</div>

<a href="#shop" class="nav-btn">
Shop
</a>

</header>

<section class="hero">

<div class="hero-content">

<h1>
Luxury Underwear Designed To Make You Feel Incredible
</h1>

<p>
Premium collections crafted for elegance, comfort and confidence.
</p>

<div class="hero-buttons">

<a href="#shop" class="hero-btn primary-btn">
Shop Collection
</a>

<a href="#reviews" class="hero-btn secondary-btn">
Customer Reviews
</a>

</div>

</div>

</section>

<section class="trust-bar">

<div class="trust-card">
<h3>Free Shipping</h3>
<p>Worldwide premium delivery.</p>
</div>

<div class="trust-card">
<h3>Luxury Quality</h3>
<p>Premium soft-touch fabrics.</p>
</div>

<div class="trust-card">
<h3>Premium Comfort</h3>
<p>Designed for confidence and elegance.</p>
</div>

<div class="trust-card">
<h3>Secure Checkout</h3>
<p>Protected Stripe payments.</p>
</div>

</section>

<h2 class="section-title" id="shop">
Featured Collection
</h2>

<p class="section-text">
Luxury essentials designed for confidence, elegance and timeless beauty.
</p>

<section class="products">

{
products.map((product)=>(

<div class="card">

<div class="badge">
{product.badge}
</div>

<img src={product.image} alt={product.name} />

<div class="card-content">

<h2>{product.name}</h2>

<p class="description">
{product.description}
</p>

<div class="price-row">

<div class="price">
{product.price}
</div>

<div class="old-price">
{product.oldPrice}
</div>

</div>

<select class="size-select">

{
product.sizes.map((size)=>(

<option value={size}>
{size}
</option>

))
}

</select>

<button
class="buy-btn"
onclick={`window.open('${product.link}','_blank')`}
>
Buy Now
</button>

<button
class="ai-product-btn"
data-prompt={product.prompt}
>
Generate AI Model Wearing This
</button>

</div>

</div>

))
}

</section>

<section class="model-generator">

<h2 class="generator-title">
AI Fashion Model Generator
</h2>

<p class="generator-text">
Generate luxury fashion campaigns instantly.
</p>

<div
class="loading"
id="loading"
>
Generating Fashion Model...
</div>

<img
id="generatedImage"
class="generated-image"
/>

</section>

<section class="reviews" id="reviews">

<h2 class="section-title">
Customer Reviews
</h2>

<div class="reviews-grid">

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
“The quality feels absolutely luxury. The fit is perfect.”
</p>

<div class="review-user">
— Sophia M.
</div>

</div>

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
“Best underwear I’ve ever bought online. Incredible comfort.”
</p>

<div class="review-user">
— Emma L.
</div>

</div>

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
“The experience feels premium and elegant.”
</p>

<div class="review-user">
— Olivia K.
</div>

</div>

</div>

</section>

<footer>
© 2026 AmicUnderwear
</footer>

<script>

const generatedImage =
document.getElementById("generatedImage");

const loading =
document.getElementById("loading");

const aiButtons =
document.querySelectorAll(".ai-product-btn");

aiButtons.forEach((button)=>{

button.addEventListener("click", async()=>{

const prompt =
button.dataset.prompt;

loading.style.display =
"block";

generatedImage.style.display =
"none";

button.disabled = true;

button.innerText =
"Generating...";

try{

const response =
await fetch("/api/generate-model",{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({
prompt
})

});

const data =
await response.json();

loading.style.display =
"none";

button.disabled = false;

button.innerText =
"Generate AI Model Wearing This";

if(data.image){

generatedImage.src =
data.image;

generatedImage.style.display =
"block";

window.scrollTo({

top:
generatedImage.offsetTop - 100,

behavior:"smooth"

});

}else{

alert(
"Generation failed. Try again."
);

}

}catch(error){

console.log(error);

loading.style.display =
"none";

button.disabled = false;

button.innerText =
"Generate AI Model Wearing This";

alert(
"Generation failed."
);

}

});

});

</script>

</body>

</html>
