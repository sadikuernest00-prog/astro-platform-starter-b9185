</head>

<body>

<header>

<div class="logo">
Amic<span>Underwear</span>
</div>

<a href="#shop" class="shop-btn">
Shop Now
</a>

</header>

<section class="hero">

<h1>
Luxury Underwear Designed For Confidence, Comfort & Elegance
</h1>

</section>

<h2 class="section-title" id="shop">
Featured Collection
</h2>

<section class="products">

{
products.map((product, index) => (

<div class="card">

<img src={product.image} alt={product.name} />

<div class="card-content">

<h2>
{product.name}
</h2>

<div class="price">
{product.price} NOK
</div>

<div class="size-label">
Select Size
</div>

<select class="size-select" id={`size-${index}`}>

{
product.sizes.map((size) => (

<option value={size}>
{size}
</option>

))
}

</select>

<div class="size-label">
Quantity
</div>

<select
class="size-select"
id={`qty-${index}`}
onchange={`updatePrice(${index})`}
>

<option value="1">1 Item</option>
<option value="2">2 Items</option>
<option value="3">3 Items</option>
<option value="4">4 Items</option>
<option value="5">5 Items</option>

</select>

<div class="total-price" id={`total-${index}`}>
Total: {product.price} NOK
</div>

<button
class="buy-btn"
onclick={`buyProduct(${index})`}
>
Buy Now
</button>

</div>

</div>

))
}

</section>

<section class="ai-box">

<h2>
AI Luxury Stylist
</h2>

<div class="ai-text">
Hear why customers love AmicUnderwear and discover our bestselling luxury collections.
</div>

<div class="voice-animation" id="voiceAnimation">

<span></span>
<span></span>
<span></span>
<span></span>
<span></span>

</div>

<div class="ai-buttons">

<button class="ai-btn" id="playVoiceBtn">
▶ Play AI Voice
</button>

<button class="ai-btn" id="stopVoiceBtn">
⏹ Stop Voice
</button>

</div>

</section>

<footer>
© 2026 AmicUnderwear — Luxury Fashion
</footer>

<script>

function updatePrice(index){

const qty =
document.getElementById(`qty-${index}`).value;

const total =
products[index].price * qty;

document.getElementById(`total-${index}`).innerHTML =
`Total: ${total} NOK`;

}

function buyProduct(index){

const qty =
document.getElementById(`qty-${index}`).value;

const size =
document.getElementById(`size-${index}`).value;

const product =
products[index];

alert(
`Added ${qty} x ${product.name}
Size: ${size}`
);

window.open(product.link, "_blank");

}

let currentAudio = null;

const playBtn =
document.getElementById("playVoiceBtn");

const stopBtn =
document.getElementById("stopVoiceBtn");

const voiceAnimation =
document.getElementById("voiceAnimation");

playBtn.addEventListener("click", async () => {

try {

voiceAnimation.classList.add("active");

if(currentAudio){

currentAudio.pause();

currentAudio.currentTime = 0;

}

const response = await fetch("/api/voice", {

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

text:`
Welcome to Amic Underwear.

Our bestselling product is the Elegant Lace Set because customers love the premium comfort, elegant fit, and luxury feel.

Customers choose Amic because we focus on confidence, comfort, premium materials, and modern feminine luxury.

Every collection is carefully selected to make you feel elegant, stylish, and comfortable every day.

Discover your perfect luxury collection today.
`

})

});

const blob = await response.blob();

const url = URL.createObjectURL(blob);

currentAudio = new Audio(url);

currentAudio.play();

currentAudio.onended = () => {

voiceAnimation.classList.remove("active");

};

} catch(error){

voiceAnimation.classList.remove("active");

alert("AI voice failed");

}

});

stopBtn.addEventListener("click", () => {

if(currentAudio){

currentAudio.pause();

currentAudio.currentTime = 0;

}

voiceAnimation.classList.remove("active");

});

</script>

</body>

</html>
