---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmicUnderwear</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f5f1ef;
        color: #111;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 60px;
        background: white;
      }

      .logo {
        font-size: 48px;
        font-weight: bold;
      }

      .logo span {
        color: #d6a36c;
      }

      .shop-btn {
        background: black;
        color: white;
        padding: 18px 40px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: bold;
      }

      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        padding: 80px 60px;
        gap: 40px;
      }

      .hero h1 {
        font-size: 96px;
        line-height: 0.95;
        margin-bottom: 20px;
      }

      .hero p {
        font-size: 28px;
      }

      .hero img {
        width: 100%;
        border-radius: 30px;
      }

      .products {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        padding: 60px;
      }

      .card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
      }

      .card img {
        width: 100%;
        height: 500px;
        object-fit: cover;
      }

      .card-content {
        padding: 24px;
      }

      .card h2 {
        font-size: 36px;
        margin-bottom: 10px;
      }

      .price {
        color: #d6a36c;
        font-size: 42px;
        font-weight: bold;
        margin-bottom: 20px;
      }

      button {
        background: black;
        color: white;
        border: none;
        padding: 16px 32px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .products {
          grid-template-columns: 1fr;
        }

        .hero h1 {
          font-size: 60px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <a href="#products" class="shop-btn">Shop Now</a>
    </header>

    <section class="hero">
      <div>
        <h1>
          Underwear designed to feel beautiful.
        </h1>

        <p>
          Luxury underwear made for confidence and comfort.
        </p>
      </div>

      <img
        src="https://images.unsplash.com/photo-1581044777550-4cfa60707c03?q=80&w=1200&auto=format&fit=crop"
        alt="Underwear"
      />
    </section>

    <section class="products" id="products">

      <!-- PRODUCT 1 -->
      <div class="card">
        <img
          src="https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?q=80&w=1200&auto=format&fit=crop"
          alt=""
        />

        <div class="card-content">
          <h2>Elegant Lace Set</h2>

          <div class="price">599 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="599" />
            <button type="submit">Buy Now</button>
          </form>
        </div>
      </div>

      <!-- PRODUCT 2 -->
      <div class="card">
        <img
          src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?q=80&w=1200&auto=format&fit=crop"
          alt=""
        />

        <div class="card-content">
          <h2>Midnight Black Collection</h2>

          <div class="price">549 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="549" />
            <button type="submit">Buy Now</button>
          </form>
        </div>
      </div>

      <!-- PRODUCT 3 -->
      <div class="card">
        <img
          src="https://images.unsplash.com/photo-1617331721458-bd3bd3f9c7f8?q=80&w=1200&auto=format&fit=crop"
          alt=""
        />

        <div class="card-content">
          <h2>Luxury Satin Sleepwear</h2>

          <div class="price">599 NOK</div>

          <form action="/api/create-checkout-session" method="POST">
            <input type="hidden" name="price" value="599" />
            <button type="submit">Buy Now</button>
          </form>
        </div>
      </div>

    </section>
  </body>
</html>
