---
const products = [
  {
    id: 1,
    name: "Élise Satin Set",
    price: 499,
    image: "/images/nude-bra.jpg",
    badge: "BEST SELLER",
    stripe: "https://buy.stripe.com/test_6oU5kC57V9y759y6jP7Re04",
  },

  {
    id: 2,
    name: "Noir Essence Collection",
    price: 549,
    image: "/images/black-bra.jpg",
    badge: "NEW",
    stripe: "https://buy.stripe.com/test_bJecN4gQD4dN31qfUp7Re03",
  },

  {
    id: 3,
    name: "Veloura Active",
    price: 499,
    image: "/images/black-set.jpg",
    badge: "HOT",
    stripe: "https://buy.stripe.com/test_4gM5kCeIvdOnfOccId7Re02",
  },

  {
    id: 4,
    name: "Aura Luxe",
    price: 499,
    image: "/images/black-b.jpg",
    badge: "NEW",
    stripe: "https://buy.stripe.com/test_4gM3cu2ZNcKjdG423z7Re01",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Amic Biotech healthcare /title>

    <style>

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        color: black;
      }

      .top-banner {
        background: black;
        color: white;
        text-align: center;
        padding: 12px;
        font-size: 14px;
        font-weight: bold;
      }

      .navbar {
        width: 100%;
        padding: 24px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        border-bottom: 1px solid #eee;
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      .logo {
        font-size: 42px;
        font-weight: 900;
      }

      .logo span {
        color: #c1965c;
      }

      .cart-btn {
        background: black;
        color: white;
        border: none;
        padding: 14px 24px;
        border-radius: 999px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
      }

      .hero {
        text-align: center;
        padding: 70px 20px 40px;
      }

      .hero h1 {
        font-size: 64px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .hero p {
        color: #666;
        font-size: 22px;
      }

      .products {
        max-width: 1450px;
        margin: auto;
        padding: 30px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
      }

      .card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        transition: 0.3s;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }

      .card:hover {
        transform: translateY(-6px);
      }

      .image-wrapper {
        position: relative;
        overflow: hidden;
      }

      .card img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        transition: 0.4s;
      }

      .card img:hover {
        transform: scale(1.05);
      }

      .badge {
        position: absolute;
        top: 18px;
        left: 18px;
        background: #c1965c;
        color: white;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: bold;
      }

      .content {
        padding: 26px;
      }

      .content h2 {
        font-size: 34px;
        margin-bottom: 12px;
        font-weight: 900;
      }

      .price {
        color: #c1965c;
        font-size: 42px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .sizes,
      .quantity {
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid #ddd;
        margin-bottom: 14px;
        font-size: 18px;
      }

      .buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .btn {
        border: none;
        text-decoration: none;
        text-align: center;
        padding: 16px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
      }

      .btn:hover {
        transform: scale(1.02);
      }

      .cart-add {
        background: #c1965c;
        color: white;
      }

      .stripe {
        background: black;
        color: white;
      }

      .cart-sidebar {
        position: fixed;
        top: 0;
        right: -450px;
        width: 420px;
        height: 100%;
        background: white;
        box-shadow: -10px 0 30px rgba(0,0,0,0.1);
        padding: 30px;
        transition: 0.4s;
        z-index: 2000;
        overflow-y: auto;
      }

      .cart-sidebar.active {
        right: 0;
      }

      .close-cart {
        position: absolute;
        top: 20px;
        right: 20px;
        background: black;
        color: white;
        border: none;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        font-size: 20px;
        cursor: pointer;
        font-weight: bold;
      }

      .cart-title {
        font-size: 34px;
        font-weight: 900;
        margin-bottom: 25px;
      }

      .cart-item {
        border-bottom: 1px solid #eee;
        padding: 18px 0;
      }

      .cart-item h4 {
        margin-bottom: 10px;
      }

      .cart-total {
        font-size: 28px;
        font-weight: 900;
        margin-top: 30px;
      }

      .checkout-buttons {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-top: 20px;
      }

      .checkout-btn {
        width: 100%;
        padding: 18px;
        border: none;
        border-radius: 999px;
        background: black;
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .remove-btn {
        margin-top: 10px;
        background: #e53935;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 999px;
        cursor: pointer;
        font-weight: bold;
      }

      .reviews-section {
        max-width: 1450px;
        margin: 80px auto;
        padding: 20px;
      }

      .reviews-title {
        text-align: center;
        font-size: 52px;
        margin-bottom: 50px;
        font-weight: 900;
      }

      .reviews-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
      }

      .review-card {
        background: white;
        padding: 35px;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }

      .stars {
        color: #c1965c;
        font-size: 24px;
        margin-bottom: 18px;
      }

      .review-text {
        color: #555;
        line-height: 1.7;
        font-size: 18px;
        margin-bottom: 20px;
      }

      .review-name {
        font-size: 20px;
        font-weight: bold;
      }

      .trustpilot-section {
        padding: 90px 20px;
        background: #fafafa;
      }

      .trustpilot-container {
        max-width: 1400px;
        margin: auto;
        text-align: center;
      }

      .trustpilot-header h2 {
        font-size: 52px;
        margin-top: 18px;
        margin-bottom: 16px;
        font-weight: 900;
      }

      .trustpilot-header p {
        color: #666;
        font-size: 20px;
        max-width: 800px;
        margin: auto;
        line-height: 1.7;
      }

      .trustpilot-stars {
        font-size: 42px;
        color: #00b67a;
      }

      .trustpilot-grid {
        margin-top: 60px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 25px;
      }

      .trustpilot-card {
        background: white;
        border-radius: 28px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        text-align: left;
      }

      .tp-stars {
        color: #00b67a;
        font-size: 24px;
        margin-bottom: 16px;
      }

      .trustpilot-card h3 {
        font-size: 28px;
        margin-bottom: 14px;
      }

      .trustpilot-card p {
        color: #555;
        line-height: 1.7;
        font-size: 18px;
        margin-bottom: 18px;
      }

      .trustpilot-card span {
        font-weight: bold;
      }

      .trustpilot-btn {
        display: inline-block;
        margin-top: 45px;
        background: #00b67a;
        color: white;
        text-decoration: none;
        padding: 18px 36px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        transition: 0.2s;
      }

      .trustpilot-btn:hover {
        transform: scale(1.03);
      }

      .footer {
        margin-top: 80px;
        padding: 60px 20px;
        text-align: center;
        background: white;
      }

      .footer h3 {
        font-size: 42px;
        margin-bottom: 14px;
      }

      .footer p {
        color: #666;
        font-size: 18px;
      }

      @media (max-width: 768px) {

        .hero h1 {
          font-size: 42px;
        }

        .logo {
          font-size: 28px;
        }

        .content h2 {
          font-size: 28px;
        }

        .price {
          font-size: 34px;
        }

        .card img {
          height: 340px;
        }

        .cart-sidebar {
          width: 100%;
        }

      }

    </style>
  </head>

  <body>

    <div class="top-banner">
      FREE WORLDWIDE SHIPPING ON ORDERS OVER 1000 NOK
    </div>

    <nav class="navbar">

      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <button class="cart-btn" onclick="toggleCart()">
        Cart (<span id="cart-count">0</span>)
      </button>

    </nav>

    <section class="hero">

      <h1>Luxury Comfort Meets Elegance</h1>

      <p>
        Premium underwear designed for confidence,
        softness and modern beauty.
      </p>

    </section>

    <section class="products">

      {
        products.map((product) => (

          <div class="card">

            <div class="image-wrapper">

              <img src={product.image} alt={product.name} />

              <div class="badge">
                {product.badge}
              </div>

            </div>

            <div class="content">

              <h2>{product.name}</h2>

              <div class="price">
                {product.price} NOK
              </div>

              <select class="sizes">
                <option>XS</option>
                <option>S</option>
                <option>M</option>
                <option>L</option>
                <option>XL</option>
              </select>

              <input
                class="quantity"
                type="number"
                min="1"
                value="1"
                id={`qty-${product.id}`}
              />

              <div class="buttons">

                <button
                  class="btn cart-add"
                  data-name={product.name}
                  data-price={product.price}
                  data-id={product.id}
                  data-stripe={product.stripe}
                >
                  Add To Cart
                </button>

                <a
                  href={product.stripe}
                  target="_blank"
                  class="btn stripe"
                >
                  Buy With Card
                </a>

              </div>

            </div>

          </div>

        ))
      }

    </section>

    <section class="reviews-section">

      <h2 class="reviews-title">
        What Our Customers Say
      </h2>

      <div class="reviews-grid">

        <div class="review-card">
          <div class="stars">★★★★★</div>

          <p class="review-text">
            “Absolutely the softest underwear I’ve ever worn.”
          </p>

          <div class="review-name">
            — Emma L.
          </div>
        </div>

      </div>

    </section>

    <section class="trustpilot-section">

      <div class="trustpilot-container">

        <div class="trustpilot-header">

          <div class="trustpilot-stars">
            ★★★★★
          </div>

          <h2>Trusted By Customers Worldwide</h2>

          <p>
            Rated Excellent on Trustpilot based on customer satisfaction,
            premium quality and fast delivery.
          </p>

        </div>

        <div class="trustpilot-grid">

          <div class="trustpilot-card">

            <div class="tp-stars">★★★★★</div>

            <h3>Amazing Quality</h3>

            <p>
              “Honestly feels like luxury designer underwear.
              Super soft and premium.”
            </p>

            <span>— Mia R.</span>

          </div>

          <div class="trustpilot-card">

            <div class="tp-stars">★★★★★</div>

            <h3>Fast Shipping</h3>

            <p>
              “Delivery was fast and packaging looked elegant.
              Will order again.”
            </p>

            <span>— Sofia K.</span>

          </div>

          <div class="trustpilot-card">

            <div class="tp-stars">★★★★★</div>

            <h3>Perfect Fit</h3>

            <p>
              “Best fitting underwear I’ve bought online.”
            </p>

            <span>— Emma L.</span>

          </div>

        </div>

        <a
          href="https://www.trustpilot.com/"
          target="_blank"
          class="trustpilot-btn"
        >
          View Trustpilot Reviews
        </a>

      </div>

    </section>

    <div class="cart-sidebar" id="cartSidebar">

      <button class="close-cart" onclick="toggleCart()">
        ✕
      </button>

      <div class="cart-title">
        Shopping Cart
      </div>

      <div id="cart-items"></div>

      <div class="cart-total">
        Total: <span id="cart-total">0</span> NOK
      </div>

      <div class="checkout-buttons">

        <button
          class="checkout-btn stripe-checkout"
          onclick="checkoutStripe()"
        >
          Pay With Card
        </button>

      </div>

    </div>

    <footer class="footer">

      <h3>Amic Underwear</h3>

      <p>
        Elegant essentials crafted for everyday luxury.
      </p>

    </footer>

    <script>

      let cart = [];

      function toggleCart() {
        document
          .getElementById("cartSidebar")
          .classList.toggle("active");
      }

      function updateCart() {

        const cartItems =
          document.getElementById("cart-items");

        const cartCount =
          document.getElementById("cart-count");

        const cartTotal =
          document.getElementById("cart-total");

        cartItems.innerHTML = "";

        let total = 0;
        let count = 0;

        cart.forEach((item, index) => {

          total += item.price * item.qty;
          count += item.qty;

          cartItems.innerHTML += `
            <div class="cart-item">

              <h4>${item.name}</h4>

              <p>${item.qty} × ${item.price} NOK</p>

              <button
                onclick="removeFromCart(${index})"
                class="remove-btn"
              >
                Remove
              </button>

            </div>
          `;

        });

        cartCount.innerText = count;
        cartTotal.innerText = total;

      }

      document
        .querySelectorAll(".cart-add")
        .forEach((button) => {

        button.addEventListener("click", () => {

          const cardLink =
            button.dataset.stripe;

          const name =
            button.dataset.name;

          const price =
            parseInt(button.dataset.price);

          const id =
            button.dataset.id;

          const qty =
            parseInt(
              document.getElementById(`qty-${id}`).value
            );

          cart.push({
            name,
            price,
            qty,
            cardLink
          });

          updateCart();

          document
            .getElementById("cartSidebar")
            .classList.add("active");

        });

      });

      function checkoutStripe() {

        if (cart.length === 0) {
          alert("Your cart is empty");
          return;
        }

        window.open(cart[0].cardLink, "_blank");

      }

      function removeFromCart(index) {

        cart.splice(index, 1);

        updateCart();

      }

      window.toggleCart = toggleCart;
      window.checkoutStripe = checkoutStripe;
      window.removeFromCart = removeFromCart;

    </script>

  </body>
</html>
