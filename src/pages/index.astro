---

<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>AmicUnderwear</title>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, Helvetica, sans-serif;
}

body{
  background:#f5f5f5;
  color:black;
}

header{
  position:sticky;
  top:0;
  z-index:999;
  background:white;
  padding:28px 40px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #eee;
}

.logo{
  font-size:54px;
  font-weight:900;
  letter-spacing:-3px;
}

.logo span{
  color:#c49a5c;
}

.shop-btn{
  background:black;
  color:white;
  border:none;
  padding:18px 34px;
  border-radius:999px;
  font-size:20px;
  font-weight:800;
  cursor:pointer;
}

.hero{
  padding:120px 20px 80px;
  text-align:center;
}

.hero h1{
  font-size:92px;
  font-weight:900;
  line-height:0.95;
  letter-spacing:-4px;
  max-width:1200px;
  margin:auto;
}

.hero p{
  margin-top:28px;
  color:#666;
  font-size:34px;
  max-width:900px;
  margin-left:auto;
  margin-right:auto;
  line-height:1.5;
}

.hero button{
  margin-top:45px;
  background:black;
  color:white;
  border:none;
  padding:28px 60px;
  border-radius:999px;
  font-size:28px;
  font-weight:900;
  cursor:pointer;
}

.products{
  max-width:1700px;
  margin:auto;
  padding:40px 20px 120px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(380px,1fr));
  gap:30px;
}

.card{
  background:white;
  border-radius:34px;
  overflow:hidden;
  position:relative;
  transition:0.3s;
}

.card:hover{
  transform:translateY(-10px);
}

.badge{
  position:absolute;
  top:20px;
  left:20px;
  background:#c49a5c;
  color:white;
  padding:14px 24px;
  border-radius:999px;
  font-size:18px;
  font-weight:900;
  z-index:10;
}

.card img{
  width:100%;
  height:650px;
  object-fit:cover;
  display:block;
  background:#eee;
}

.card-content{
  padding:30px;
}

.card h2{
  font-size:56px;
  line-height:1;
  font-weight:900;
  letter-spacing:-2px;
  margin-bottom:20px;
}

.price{
  font-size:72px;
  font-weight:900;
  color:#c49a5c;
  margin-bottom:25px;
}

select{
  width:100%;
  padding:18px;
  border-radius:16px;
  border:2px solid #eee;
  font-size:24px;
  margin-bottom:20px;
}

.buy-btn{
  width:100%;
  background:black;
  color:white;
  border:none;
  padding:26px;
  border-radius:999px;
  font-size:30px;
  font-weight:900;
  cursor:pointer;
  margin-bottom:18px;
}

.buy-btn:hover{
  opacity:0.92;
}

.monero-btn{
  width:100%;
  background:#c49a5c;
  color:white;
  border:none;
  padding:24px;
  border-radius:999px;
  font-size:26px;
  font-weight:900;
  cursor:pointer;
}

.monero-btn:hover{
  opacity:0.92;
}

.reviews{
  padding:100px 20px;
  background:white;
  text-align:center;
}

.reviews h2{
  font-size:70px;
  font-weight:900;
  margin-bottom:60px;
}

.review-grid{
  max-width:1400px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:30px;
}

.review{
  background:#f5f5f5;
  padding:40px;
  border-radius:30px;
  text-align:left;
}

.review .stars{
  color:#c49a5c;
  font-size:28px;
  margin-bottom:20px;
}

.review p{
  color:#444;
  line-height:1.6;
  font-size:24px;
}

.review h3{
  margin-top:25px;
  font-size:22px;
}

footer{
  background:black;
  color:white;
  padding:80px 20px;
  text-align:center;
}

footer h2{
  font-size:60px;
  margin-bottom:20px;
}

footer p{
  color:#bbb;
  font-size:24px;
}

@media(max-width:900px){

  .logo{
    font-size:38px;
  }

  .hero h1{
    font-size:58px;
  }

  .hero p{
    font-size:24px;
  }

  .card h2{
    font-size:42px;
  }

  .price{
    font-size:52px;
  }

  .card img{
    height:500px;
  }

}

</style>
</head>

<body>

<header>

  <div class="logo">
    Amic<span>Underwear</span>
  </div>

  <button class="shop-btn">
    Shop
  </button>

</header>

<section class="hero">

  <h1>
    Luxury Underwear Made For Confidence
  </h1>

  <p>
    Elegant premium collections designed for beauty, comfort and confidence.
  </p>

  <button onclick="document.querySelector('.products').scrollIntoView({behavior:'smooth'})">
    Explore Collection
  </button>

</section>

<section class="products">

  {
    products.map((product) => (

      <div class="card">

        <div class="badge">
          {product.badge}
        </div>

        <img
          src={product.image}
          alt={product.name}
          loading="lazy"
        />

        <div class="card-content">

          <h2>{product.name}</h2>

          <div class="price">
            {product.price}
          </div>

          <select>
            <option>XS</option>
            <option>S</option>
            <option>M</option>
            <option>L</option>
            <option>XL</option>
          </select>

          <button
            class="buy-btn"
            onclick={`window.location.href='${product.payment}'`}
          >
            Buy Now
          </button>

          <button
            class="monero-btn"
            onclick={`window.location.href='${product.payment}'`}
          >
            Buy With Monero
          </button>

        </div>

      </div>

    ))
  }

</section>

<section class="reviews">

  <h2>
    Loved By Customers
  </h2>

  <div class="review-grid">

    <div class="review">
      <div class="stars">★★★★★</div>

      <p>
        Incredible quality and beautiful fit. Feels like luxury designer underwear.
      </p>

      <h3>
        — Sophia M.
      </h3>
    </div>

    <div class="review">
      <div class="stars">★★★★★</div>

      <p>
        Very soft fabrics and elegant designs. The lace set is my favorite.
      </p>

      <h3>
        — Emma R.
      </h3>
    </div>

    <div class="review">
      <div class="stars">★★★★★</div>

      <p>
        Beautiful premium collection and very comfortable for everyday wear.
      </p>

      <h3>
        — Olivia K.
      </h3>
    </div>

  </div>

</section>

<footer>

  <h2>
    AmicUnderwear
  </h2>

  <p>
    Luxury essentials crafted for confidence.
  </p>

</footer>

</body>
</html>
