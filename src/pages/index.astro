
---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AmicBridge Pro | Forex Education, Insights & Tools</title>
    <meta
      name="description"
      content="Join AmicBridge Pro for premium forex education, market insights, trading tools, and members-only resources."
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <div>
          <a href="/" class="logo">
            <span class="dark">AMIC</span><span class="blue">BRIDGE</span>
          </a>
          <p class="tagline">Forex education & market insights</p>
        </div>

        <nav class="menu">
          <a href="#offer">Offer</a>
          <a href="#features">Features</a>
          <a href="#pricing">Pricing</a>
          <a href="#contact">Contact</a>
        </nav>

        <a href="#pricing" class="nav-btn">Join Now</a>
      </div>
    </header>

    <main class="hero">
      <div class="container hero-grid">
        <section class="left">
          <div class="badge">PRO MEMBERSHIP</div>
          <h1>Trade With More Clarity, Structure, and Confidence.</h1>
          <p class="lead">
            AmicBridge Pro is a premium forex education and market insights
            membership for traders who want better analysis, smarter tools, and
            stronger decision-making.
          </p>

          <ul class="benefits">
            <li>📊 Premium market insights</li>
            <li>📚 Structured forex education</li>
            <li>🛠 Trading tools & calculators</li>
            <li>🎯 Trade ideas & market breakdowns</li>
            <li>👥 Members-only support</li>
          </ul>

          <div class="actions">
            <a href="#pricing" class="btn primary">Get Access for $499</a>
            <a href="#features" class="btn secondary">See What’s Included</a>
          </div>
        </section>

        <section class="right">
          <div class="card pricing-card">
            <div class="price-top">AMICBRIDGE PRO</div>
            <div class="price-row">
              <span class="price">$499</span>
              <span class="period">/ access</span>
            </div>
            <p class="price-text">
              Premium education, market insights, strategy resources, and tools
              for traders who want to improve their own execution.
            </p>

            <a href="#contact" class="btn primary full">Join Membership</a>
          </div>

          <div class="card trust-card">
            <h3>Important</h3>
            <p>
              AmicBridge does not manage funds, trade on your behalf, or
              guarantee profits. We provide education, analysis, and tools so
              you can make your own trading decisions.
            </p>
          </div>
        </section>
      </div>

      <section id="features" class="container features">
        <h2>What you get inside</h2>
        <div class="feature-grid">
          <div class="feature-card">
            <h3>Learn</h3>
            <p>Step-by-step forex education for beginners and developing traders.</p>
          </div>
          <div class="feature-card">
            <h3>Analyze</h3>
            <p>Weekly insights, macro context, and currency market breakdowns.</p>
          </div>
          <div class="feature-card">
            <h3>Use Tools</h3>
            <p>Position sizing, risk tools, and structured trading resources.</p>
          </div>
          <div class="feature-card">
            <h3>Improve</h3>
            <p>Refine your process and make more disciplined decisions over time.</p>
          </div>
        </div>
      </section>

      <section id="pricing" class="container pricing-section">
        <div class="pricing-box">
          <h2>One premium offer</h2>
          <p class="pricing-sub">
            Join AmicBridge Pro for <strong>$499</strong> and access premium forex
            education, insights, and tools.
          </p>
          <a href="#contact" class="btn primary">Apply / Join Now</a>
        </div>
      </section>
    </main>

    <footer class="footer" id="contact">
      <div class="container">
        <p>
          AmicBridge provides education, market insights, and trading tools
          only. Nothing on this website is financial advice or a promise of
          results.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #f4f6fb;
    --card: #ffffff;
    --soft: #eef4ff;
    --text: #111827;
    --muted: #667085;
    --border: #d9e1ec;
    --primary: #2948a3;
    --primary-dark: #1f397f;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .container {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header {
    background: rgba(255,255,255,0.85);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }

  .nav {
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  .logo .dark { color: var(--text); }
  .logo .blue { color: var(--primary); }

  .tagline {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .menu {
    display: flex;
    gap: 28px;
    font-weight: 600;
  }

  .nav-btn,
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    font-weight: 800;
    transition: 0.2s ease;
  }

  .nav-btn {
    background: var(--primary);
    color: white;
    padding: 14px 22px;
  }

  .hero {
    padding: 72px 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: start;
  }

  .badge {
    display: inline-block;
    background: #dbeafe;
    color: #0f5fa8;
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 800;
    margin-bottom: 22px;
  }

  h1 {
    margin: 0 0 18px;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .lead {
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 720px;
  }

  .benefits {
    list-style: none;
    padding: 0;
    margin: 28px 0;
    display: grid;
    gap: 14px;
    font-size: 1.15rem;
    color: #445065;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .btn {
    min-height: 56px;
    padding: 0 26px;
  }

  .btn.primary {
    background: var(--primary);
    color: white;
  }

  .btn.primary:hover,
  .nav-btn:hover {
    background: var(--primary-dark);
  }

  .btn.secondary {
    background: white;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn.full {
    width: 100%;
  }

  .right {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 28px;
  }

  .pricing-card {
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  }

  .price-top {
    color: var(--primary);
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  .price-row {
    display: flex;
    align-items: end;
    gap: 10px;
    margin-bottom: 10px;
  }

  .price {
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
  }

  .period {
    color: var(--muted);
    font-size: 1.1rem;
    margin-bottom: 8px;
  }

  .price-text {
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .trust-card {
    background: var(--soft);
  }

  .trust-card h3 {
    margin-top: 0;
    font-size: 1.6rem;
  }

  .trust-card p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .features {
    padding-top: 36px;
    padding-bottom: 36px;
  }

  .features h2,
  .pricing-section h2 {
    font-size: 2.2rem;
    margin-bottom: 20px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .feature-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 22px;
  }

  .feature-card h3 {
    margin-top: 0;
    margin-bottom: 10px;
  }

  .feature-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .pricing-section {
    padding-bottom: 70px;
  }

  .pricing-box {
    background: white;
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 32px;
    text-align: center;
  }

  .pricing-sub {
    color: var(--muted);
    font-size: 1.1rem;
    margin-bottom: 22px;
  }

  .footer {
    background: white;
    border-top: 1px solid var(--border);
  }

  .footer .container {
    padding: 24px 0 32px;
  }

  .footer p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .menu {
      display: none;
    }
  }
</style>
