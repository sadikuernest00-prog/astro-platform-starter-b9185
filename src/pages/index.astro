---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

<title>AmicUnderwear</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f5f5f5;
color:#111;
}

/* HEADER */

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 30px;
background:white;
position:sticky;
top:0;
z-index:100;
border-bottom:1px solid #eee;
}

.logo{
font-size:36px;
font-weight:900;
letter-spacing:-1px;
}

.logo span{
color:#c79b5d;
}

.shop-btn{
background:black;
color:white;
padding:12px 24px;
border-radius:40px;
text-decoration:none;
font-weight:700;
font-size:15px;
}

/* HERO */

.hero{
padding:70px 20px 50px;
text-align:center;
max-width:1100px;
margin:auto;
}

.hero h1{
font-size:58px;
font-weight:900;
line-height:1;
margin-bottom:18px;
letter-spacing:-2px;
}

.hero p{
font-size:20px;
color:#666;
line-height:1.5;
max-width:700px;
margin:auto;
}

/* PRODUCTS */

.products{
max-width:1400px;
margin:auto;
padding:20px;
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(280px,1fr));
gap:24px;
}

.card{
background:white;
border-radius:24px;
overflow:hidden;
box-shadow:0 8px 20px rgba(0,0,0,0.05);
transition:0.3s;
position:relative;
}

.card:hover{
transform:translateY(-5px);
}

.badge{
position:absolute;
top:16px;
left:16px;
background:#c79b5d;
color:white;
padding:8px 16px;
border-radius:30px;
font-size:12px;
font-weight:700;
z-index:2;
}

.card img{
width:100%;
height:420px;
object-fit:cover;
background:#ececec;
}

.content{
padding:22px;
}

.content h2{
font-size:28px;
font-weight:900;
margin-bottom:12px;
line-height:1.1;
}

.price{
font-size:34px;
font-weight:900;
color:#c79b5d;
margin-bottom:18px;
}

select{
width:100%;
padding:14px;
border-radius:12px;
border:1px solid #ddd;
margin-bottom:14px;
font-size:16px;
background:white;
}

/* BUTTONS */

.btn{
width:100%;
border:none;
padding:15px;
border-radius:40px;
font-size:16px;
font-weight:800;
cursor:pointer;
transition:0.3s;
margin-top:10px;
}

.stripe-btn{
background:black;
color:white;
}

.monero-btn{
background:#c79b5d;
color:white;
}

.ai-btn{
background:white;
border:2px solid black;
color:black;
}

.btn:hover{
opacity:0.92;
transform:translateY(-2px);
}

/* TRUST */

.trust{
padding:70px 20px;
text-align:center;
}

.trust h2{
font-size:42px;
margin-bottom:35px;
font-weight:900;
}

.trust-grid{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));
gap:20px;
max-width:1200px;
margin:auto;
}

.trust-box{
background:white;
padding:28px;
border-radius:22px;
box-shadow:0 8px 20px rgba(0,0,0,0.04);
}

.trust-box h3{
font-size:22px;
margin-bottom:10px;
}

.trust-box p{
color:#666;
font-size:15px;
line-height:1.6;
}

/* FOOTER */

footer{
background:black;
color:white;
text-align:center;
padding:40px 20px;
margin-top:50px;
}

footer h2{
font-size:28px;
margin-bottom:8px;
}

footer p{
color:#aaa;
font-size:14px;
}

/* MOBILE */

@media(max-width:768px){

.logo{
font-size:28px;
}

.hero h1{
font-size:40px;
}

.hero p{
font-size:16px;
}

.card img{
height:340px;
}

.content h2{
font-size:24px;
}

.price{
font-size:28px;
}

.btn{
font-size:15px;
padding:14px;
}

}

</style>

</head>

<body>

<header>

<div class="logo">
Amic<span>Underwear</span>
</div>

<a href="#shop" class="shop-btn">
Shop
</a>

</header>

<section class="hero">

<h1>
Luxury Underwear Designed For Confidence
</h1>

<p>
Discover premium comfort, elegant designs and timeless luxury pieces.
</p>

</section>

<section class="products" id="shop">

{
products.map((product)=>(

<div class="card">

<div class="badge">
{product.badge}
</div>

<img
src={product.image}
alt={product.name}
/>

<div class="content">

<h2>{product.name}</h2>

<div class="price">
{product.price}
</div>

<select>
<option>XS</option>
<option>S</option>
<option>M</option>
<option>L</option>
<option>XL</option>
</select>

<button
class="btn stripe-btn"
onclick={`window.open('${product.stripe}','_blank')`}
>
Pay With Card
</button>

<button
class="btn monero-btn"
onclick={`window.open('${product.monero}','_blank')`}
>
Pay With Monero
</button>

<button
class="btn ai-btn"
>
Generate AI Model
</button>

</div>

</div>

))
}

</section>

<section class="trust">

<h2>
Why Customers Love AmicUnderwear
</h2>

<div class="trust-grid">

<div class="trust-box">

<h3>
Premium Quality
</h3>

<p>
Soft luxury fabrics designed for comfort and elegance.
</p>

</div>

<div class="trust-box">

<h3>
Worldwide Shipping
</h3>

<p>
Secure international delivery with luxury packaging.
</p>

</div>

<div class="trust-box">

<h3>
Private Payments
</h3>

<p>
Pay securely with Stripe or Monero crypto checkout.
</p>

</div>

<div class="trust-box">

<h3>
Luxury Fit
</h3>

<p>
Beautiful feminine fit designed for confidence.
</p>

</div>

</div>

</section>

<footer>

<h2>
AmicUnderwear
</h2>

<p>
Luxury underwear made for confidence and comfort.
</p>

</footer>

</body>

</html>
