---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

<title>AmicUnderwear</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#f5f5f5;
color:#111;
overflow-x:hidden;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 40px;
background:white;
position:sticky;
top:0;
z-index:100;
box-shadow:0 5px 20px rgba(0,0,0,0.05);
}

.logo{
font-size:42px;
font-weight:700;
}

.logo span{
color:#b58a56;
}

.shop-btn{
background:black;
color:white;
padding:14px 30px;
border-radius:100px;
text-decoration:none;
font-weight:600;
}

.hero{
height:80vh;

background:
linear-gradient(rgba(0,0,0,0.35),rgba(0,0,0,0.35)),
url('/images/hero.jpg');

background-size:cover;
background-position:center;

display:flex;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

.hero h1{
font-size:72px;
max-width:900px;
line-height:1.1;
color:white;
}

.section-title{
text-align:center;
font-size:54px;
margin:80px 0 50px;
font-weight:700;
}

.products{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(320px,1fr));

gap:30px;

padding:0 40px 100px;
}

.card{
background:white;
border-radius:30px;
overflow:hidden;
box-shadow:0 10px 30px rgba(0,0,0,0.08);
transition:0.4s;
position:relative;
}

.card:hover{
transform:translateY(-10px);
}

.badge{
position:absolute;
top:20px;
left:20px;
background:#b58a56;
color:white;
padding:10px 18px;
border-radius:50px;
font-size:14px;
font-weight:600;
}

.card img{
width:100%;
height:430px;
object-fit:cover;
}

.card-content{
padding:25px;
}

.card h2{
font-size:30px;
margin-bottom:10px;
}

.price{
font-size:40px;
font-weight:700;
color:#b58a56;
margin-bottom:20px;
}

.size-select{
width:100%;
padding:14px;
border-radius:16px;
border:2px solid #eee;
margin-bottom:20px;
font-size:17px;
}

.buy-btn{
width:100%;
background:black;
color:white;
padding:18px;
border:none;
border-radius:100px;
font-size:20px;
font-weight:600;
cursor:pointer;
}

.buy-btn:hover{
background:#b58a56;
}

/* AI MODEL */

.model-generator{
padding:80px 20px;
text-align:center;
}

.generator-title{
font-size:58px;
margin-bottom:20px;
}

.generator-text{
font-size:22px;
color:#666;
margin-bottom:35px;
}

.generate-btn{
background:black;
color:white;
padding:20px 45px;
border:none;
border-radius:100px;
font-size:24px;
font-weight:600;
cursor:pointer;
transition:0.3s;
}

.generate-btn:hover{
background:#b58a56;
}

.loading{
margin-top:30px;
font-size:24px;
display:none;
}

.generated-image{
margin-top:40px;
max-width:600px;
width:100%;
border-radius:30px;
display:none;
box-shadow:0 10px 40px rgba(0,0,0,0.15);
}

/* REVIEWS */

.reviews{
padding:40px 40px 100px;
}

.reviews-title{
text-align:center;
font-size:54px;
margin-bottom:50px;
}

.reviews-grid{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(280px,1fr));

gap:30px;
}

.review-card{
background:white;
padding:35px;
border-radius:30px;
box-shadow:0 10px 30px rgba(0,0,0,0.08);
}

.stars{
font-size:28px;
color:#b58a56;
margin-bottom:20px;
}

.review-text{
font-size:20px;
line-height:1.6;
margin-bottom:20px;
color:#444;
}

.review-user{
font-size:18px;
font-weight:600;
}

footer{
padding:50px;
text-align:center;
font-size:18px;
color:#777;
}

@media(max-width:768px){

.hero h1{
font-size:42px;
}

.section-title,
.generator-title,
.reviews-title{
font-size:38px;
}

.products,
.reviews{
padding:20px;
}

.card img{
height:340px;
}

}

</style>

</head>

<body>

<header>

<div class="logo">
Amic<span>Underwear</span>
</div>

<a href="#shop" class="shop-btn">
Shop
</a>

</header>

<section class="hero">

<h1>
Luxury Underwear Powered By AI Fashion
</h1>

</section>

<h2 class="section-title" id="shop">
Featured Collection
</h2>

<section class="products">

{
products.map((product)=>(

<div class="card">

<div class="badge">
{product.badge}
</div>

<img src={product.image} alt={product.name} />

<div class="card-content">

<h2>{product.name}</h2>

<div class="price">
{product.price}
</div>

<select class="size-select">

{
product.sizes.map((size)=>(

<option value={size}>
{size}
</option>

))
}

</select>

<button
class="buy-btn"
onclick={`window.open('${product.link}','_blank')`}
>
Buy Now
</button>

</div>

</div>

))
}

</section>

<!-- AI MODEL -->

<section class="model-generator">

<h2 class="generator-title">
AI Fashion Model Generator
</h2>

<p class="generator-text">
Generate luxury AI fashion campaigns instantly.
</p>

<button
id="generateBtn"
class="generate-btn"
>
Generate AI Model
</button>

<div
class="loading"
id="loading"
>
Generating AI Fashion Model...
</div>

<img
id="generatedImage"
class="generated-image"
/>

</section>

<!-- REVIEWS -->

<section class="reviews">

<h2 class="reviews-title">
Customer Reviews
</h2>

<div class="reviews-grid">

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
"The quality feels absolutely luxury."
</p>

<div class="review-user">
— Sophia M.
</div>

</div>

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
"Best underwear I’ve ever bought online."
</p>

<div class="review-user">
— Emma L.
</div>

</div>

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
"The AI experience feels incredible."
</p>

<div class="review-user">
— Olivia K.
</div>

</div>

</div>

</section>

<footer>
© 2026 AmicUnderwear
</footer>

<script>

const generateBtn =
document.getElementById("generateBtn");

const generatedImage =
document.getElementById("generatedImage");

const loading =
document.getElementById("loading");

generateBtn.addEventListener("click", async()=>{

loading.style.display =
"block";

generatedImage.style.display =
"none";

try{

const response =
await fetch("/api/generate-model",{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

prompt:
"Ultra realistic luxury female fashion model wearing elegant luxury lingerie, studio lighting, luxury fashion campaign, photorealistic"

})

});

const data =
await response.json();

loading.style.display =
"none";

if(data.image){

generatedImage.src =
data.image;

generatedImage.style.display =
"block";

}else{

alert("AI generation failed");

}

}catch(error){

loading.style.display =
"none";

alert("AI generation failed");

}

});

</script>

</body>

</html>
