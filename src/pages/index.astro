---
const products = [
  {
    name: "Elegant Lace Set",
    price: "599 NOK",
    image: "/images/white-lace.jpg",
    badge: "Best Seller"
  },
  {
    name: "Midnight Black Collection",
    price: "549 NOK",
    image: "/images/black-set.jpg",
    badge: "New"
  },
  {
    name: "Luxury Satin Sleepwear",
    price: "599 NOK",
    image: "/images/satin-set.jpg",
    badge: "Luxury"
  },
  {
    name: "Comfort Seamless Bra",
    price: "449 NOK",
    image: "/images/white-bra.jpg",
    badge: "Popular"
  },
  {
    name: "Black Comfort Bra",
    price: "449 NOK",
    image: "/images/black-bra.jpg",
    badge: "Trending"
  },
  {
    name: "Nude Comfort Bra",
    price: "449 NOK",
    image: "/images/nude-bra.jpg",
    badge: "Soft Fit"
  },
];
---

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>AmicUnderwear</title>

  <style>

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #faf7f5;
      color: #111;
    }

    .container {
      width: 90%;
      max-width: 1300px;
      margin: auto;
    }

    header {
      position: sticky;
      top: 0;
      background: white;
      padding: 20px 0;
      z-index: 10;
      border-bottom: 1px solid #eee;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 32px;
      font-weight: bold;
    }

    .logo span {
      color: #d4a373;
    }

    .btn {
      background: black;
      color: white;
      padding: 14px 24px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      font-weight: bold;
      text-decoration: none;
    }

    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
      padding: 80px 0;
    }

    .hero h1 {
      font-size: 70px;
      line-height: 1;
      margin-bottom: 20px;
    }

    .hero img {
      width: 100%;
      border-radius: 30px;
      height: 700px;
      object-fit: cover;
    }

    .section-title {
      text-align: center;
      margin: 80px 0 40px;
    }

    .section-title h2 {
      font-size: 60px;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .product-card {
      background: white;
      border-radius: 30px;
      overflow: hidden;
      padding-bottom: 20px;
    }

    .product-card img {
      width: 100%;
      height: 450px;
      object-fit: cover;
    }

    .product-info {
      padding: 20px;
    }

    .price {
      font-size: 24px;
      color: #d4a373;
      font-weight: bold;
      margin: 15px 0;
    }

    .badge {
      position: absolute;
      background: white;
      padding: 10px 14px;
      border-radius: 999px;
      margin: 20px;
      font-weight: bold;
    }

    footer {
      padding: 60px 0;
      text-align: center;
      color: #777;
    }

    @media(max-width: 900px) {

      .hero {
        grid-template-columns: 1fr;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 48px;
      }

    }

  </style>

</head>

<body>

<header>

  <div class="container">

    <nav>

      <div class="logo">
        Amic<span>Underwear</span>
      </div>

      <a href="#shop" class="btn">
        Shop Now
      </a>

    </nav>

  </div>

</header>

<main>

<section class="hero container">

  <div>

    <h1>
      Underwear designed to feel beautiful.
    </h1>

    <p>
      Luxury underwear made for confidence and comfort.
    </p>

    <a href="#shop" class="btn">
      Explore Collection
    </a>

  </div>

  <div>

    <img
      src="/images/hero.jpg"
      alt="Hero"
    />

  </div>

</section>

<section
  class="container"
  id="shop"
>

  <div class="section-title">

    <h2>Featured Collection</h2>

  </div>

  <div class="product-grid">

    {
      products.map((product) => (

        <div class="product-card">

          <div class="badge">
            {product.badge}
          </div>

          <img
            src={product.image}
            alt={product.name}
          />

          <div class="product-info">

            <h3>{product.name}</h3>

            <div class="price">
              {product.price}
            </div>

            <button class="btn buy-button">
              Buy Now
            </button>

          </div>

        </div>

      ))
    }

  </div>

</section>

</main>

<footer>

  © 2026 AmicUnderwear

</footer>

<script src="https://js.stripe.com/v3/"></script>

<script>

  const stripe = Stripe(
    import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY
  );

  document.querySelectorAll(".buy-button").forEach((button) => {

    button.addEventListener("click", async () => {

      try {

        const response = await fetch(
          "/api/create-checkout-session",
          {
            method: "POST",
          }
        );

        const session = await response.json();

        if (session.id) {

          await stripe.redirectToCheckout({
            sessionId: session.id,
          });

        } else {

          alert("Stripe failed");

        }

      } catch (err) {

        alert("Payment error");

      }

    });

  });

</script>

</body>

</html>
