---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Amic Luxury Underwear</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f8f5f0;
        color: #111;
      }

      .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 40px 20px;
      }

      h1 {
        font-size: 72px;
        margin-bottom: 20px;
        font-weight: 800;
      }

      .subtitle {
        font-size: 24px;
        max-width: 900px;
        line-height: 1.6;
        margin-bottom: 50px;
      }

      .voice-animation {
        display: flex;
        gap: 12px;
        margin-bottom: 40px;
        height: 120px;
        align-items: center;
      }

      .bar {
        width: 22px;
        background: #8b672f;
        border-radius: 20px;
        height: 40px;
      }

      .voice-animation.active .bar:nth-child(1) {
        animation: bounce 0.8s infinite;
      }

      .voice-animation.active .bar:nth-child(2) {
        animation: bounce 0.8s infinite 0.1s;
      }

      .voice-animation.active .bar:nth-child(3) {
        animation: bounce 0.8s infinite 0.2s;
      }

      .voice-animation.active .bar:nth-child(4) {
        animation: bounce 0.8s infinite 0.3s;
      }

      .voice-animation.active .bar:nth-child(5) {
        animation: bounce 0.8s infinite 0.4s;
      }

      @keyframes bounce {
        0% {
          height: 40px;
        }
        50% {
          height: 120px;
        }
        100% {
          height: 40px;
        }
      }

      .buttons {
        display: flex;
        gap: 25px;
        margin-bottom: 70px;
        flex-wrap: wrap;
        justify-content: center;
      }

      button {
        border: none;
        cursor: pointer;
        padding: 24px 50px;
        font-size: 32px;
        border-radius: 70px;
        font-weight: bold;
        transition: 0.3s;
      }

      .play-btn {
        background: #8b672f;
        color: white;
      }

      .play-btn:hover {
        transform: scale(1.05);
      }

      .stop-btn {
        background: black;
        color: white;
      }

      .stop-btn:hover {
        transform: scale(1.05);
      }

      .products {
        width: 100%;
        max-width: 1400px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 35px;
      }

      .card {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        transition: 0.4s;
      }

      .card:hover {
        transform: translateY(-10px);
      }

      .card img {
        width: 100%;
        height: 420px;
        object-fit: cover;
      }

      .card-content {
        padding: 30px;
      }

      .card h2 {
        font-size: 32px;
        margin-bottom: 15px;
      }

      .card p {
        font-size: 18px;
        line-height: 1.6;
        margin-bottom: 20px;
      }

      .price {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #8b672f;
      }

      select {
        width: 100%;
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 18px;
      }

      .buy-btn {
        display: block;
        width: 100%;
        text-align: center;
        background: black;
        color: white;
        padding: 18px;
        border-radius: 16px;
        text-decoration: none;
        font-size: 22px;
        font-weight: bold;
        transition: 0.3s;
      }

      .buy-btn:hover {
        background: #8b672f;
      }

      @media(max-width: 768px) {

        h1 {
          font-size: 48px;
        }

        .subtitle {
          font-size: 18px;
        }

        button {
          font-size: 24px;
          padding: 20px 35px;
        }

      }
    </style>
  </head>

  <body>

    <section class="hero">

      <h1>Amic Luxury Style</h1>

      <p class="subtitle">
        Hear why customers love our elegant lace collections, satin sleepwear,
        and premium luxury underwear designed for confidence, comfort, and beauty.
      </p>

      <div id="voiceAnimation" class="voice-animation">
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
      </div>

      <div class="buttons">
        <button id="playVoiceBtn" class="play-btn">
          ▶ Play AI Voice
        </button>

        <button id="stopVoiceBtn" class="stop-btn">
          ■ Stop Voice
        </button>
      </div>

      <div class="products">

        <div class="card">
          <img src="https://images.unsplash.com/photo-1581044777550-4cfa60707c03?q=80&w=1200&auto=format&fit=crop" />

          <div class="card-content">
            <h2>Elegant Lace Set</h2>

            <p>
              Soft luxury lace underwear collection designed for elegance and confidence.
            </p>

            <div class="price">599 NOK</div>

            <select>
              <option>Choose Size</option>
              <option>XS</option>
              <option>S</option>
              <option>M</option>
              <option>L</option>
            </select>

            <a
              href="https://buy.stripe.com/test_4gM3cu2ZNcKjdG423z7Re01"
              target="_blank"
              class="buy-btn"
            >
              Buy Now
            </a>
          </div>
        </div>

        <div class="card">
          <img src="https://images.unsplash.com/photo-1618244972963-dbad68f8d6c3?q=80&w=1200&auto=format&fit=crop" />

          <div class="card-content">
            <h2>Midnight Black Collection</h2>

            <p>
              Elegant premium black collection with luxury comfort and soft satin feel.
            </p>

            <div class="price">599 NOK</div>

            <select>
              <option>Choose Size</option>
              <option>XS</option>
              <option>S</option>
              <option>M</option>
              <option>L</option>
            </select>

            <a
              href="https://buy.stripe.com/test_4gM5kCeIvdOnfOccId7Re02"
              target="_blank"
              class="buy-btn"
            >
              Buy Now
            </a>
          </div>
        </div>

        <div class="card">
          <img src="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?q=80&w=1200&auto=format&fit=crop" />

          <div class="card-content">
            <h2>Luxury Satin Sleepwear</h2>

            <p>
              Premium satin luxury sleepwear collection for beauty and comfort.
            </p>

            <div class="price">599 NOK</div>

            <select>
              <option>Choose Size</option>
              <option>XS</option>
              <option>S</option>
              <option>M</option>
              <option>L</option>
            </select>

            <a
              href="https://buy.stripe.com/test_bJecN4gQD4dN31qfUp7Re03"
              target="_blank"
              class="buy-btn"
            >
              Buy Now
            </a>
          </div>
        </div>

        <div class="card">
          <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1200&auto=format&fit=crop" />

          <div class="card-content">
            <h2>Luxury Comfort Bra</h2>

            <p>
              Minimal luxury comfort bra with ultra-soft premium fabric feel.
            </p>

            <div class="price">599 NOK</div>

            <select>
              <option>Choose Size</option>
              <option>XS</option>
              <option>S</option>
              <option>M</option>
              <option>L</option>
            </select>

            <a
              href="https://buy.stripe.com/test_6oU5kC57V9y759y6jP7Re04"
              target="_blank"
              class="buy-btn"
            >
              Buy Now
            </a>
          </div>
        </div>

      </div>

    </section>

    <script>

      let speech = null;

      const playBtn =
      document.getElementById("playVoiceBtn");

      const stopBtn =
      document.getElementById("stopVoiceBtn");

      const voiceAnimation =
      document.getElementById("voiceAnimation");

      function startAnimation() {
        voiceAnimation.classList.add("active");
      }

      function stopAnimation() {
        voiceAnimation.classList.remove("active");
      }

      playBtn.addEventListener("click", () => {

        window.speechSynthesis.cancel();

        speech = new SpeechSynthesisUtterance(
          "Welcome to Amic Underwear. We specialize in luxury underwear, elegant lace collections, satin sleepwear, and premium comfort styles designed for confidence and beauty. Shop now and discover why customers love Amic."
        );

        speech.lang = "en-US";
        speech.rate = 0.95;
        speech.pitch = 1;
        speech.volume = 1;

        startAnimation();

        speech.onend = () => {
          stopAnimation();
        };

        speech.onerror = () => {
          stopAnimation();
          alert("Voice failed.");
        };

        window.speechSynthesis.speak(speech);

      });

      stopBtn.addEventListener("click", () => {

        window.speechSynthesis.cancel();

        stopAnimation();

      });

    </script>

  </body>
</html>
