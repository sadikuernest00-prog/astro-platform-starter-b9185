  {
    name: "Elegant Lace Set",
    price: "599 NOK",
    image: "/images/elegant-lace-set.png",
    badge: "BEST SELLER",
    stripe: "https://buy.stripe.com/test_6oU5kC57V9y759y6jP7Re04",
    monero: "https://nowpayments.io/payment/?iid=4680546954",
  },

  {
    name: "Midnight Black Collection",
    price: "549 NOK",
    image: "/images/midnight-black.png",
    badge: "NEW",
    stripe: "https://buy.stripe.com/test_bJecN4gQD4dN31qfUp7Re03",
    monero: "https://nowpayments.io/payment/?iid=4680546954",
  },

  {
    name: "Luxury Sports Bra",
    price: "499 NOK",
    image: "/images/luxury-sports-bra.png",
    badge: "HOT",
    stripe: "https://buy.stripe.com/test_4gM5kCeIvdOnfOccId7Re02",
    monero: "https://nowpayments.io/payment/?iid=4680546954",
  },

  {
    name: "Soft Nude Comfort",
    price: "529 NOK",
    image: "/images/soft-nude-comfort.png",
    badge: "NEW",
    stripe: "https://buy.stripe.com/test_4gM3cu2ZNcKjdG423z7Re01",
    monero: "https://nowpayments.io/payment/?iid=4680546954",
  },

  {
    name: "Luxury Satin Sleepwear",
    price: "649 NOK",
    image: "/images/luxury-satin-sleepwear.png",
    badge: "PREMIUM",
    stripe: "https://buy.stripe.com/test_6oU5kC57V9y759y6jP7Re04",
    monero: "https://nowpayments.io/payment/?iid=4680546954",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Amic Underwear</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        color: black;
      }

      .navbar {
        width: 100%;
        padding: 24px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid #eee;
      }

      .logo {
        font-size: 42px;
        font-weight: 900;
      }

      .logo span {
        color: #c1965c;
      }

      .hero {
        text-align: center;
        padding: 70px 20px 40px;
      }

      .hero h1 {
        font-size: 64px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .hero p {
        color: #666;
        font-size: 22px;
      }

      .products {
        max-width: 1450px;
        margin: auto;
        padding: 30px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
      }

      .card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        transition: 0.3s;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }

      .card:hover {
        transform: translateY(-6px);
      }

      .image-wrapper {
        position: relative;
        overflow: hidden;
      }

      .card img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        display: block;
      }

      .badge {
        position: absolute;
        top: 18px;
        left: 18px;
        background: #c1965c;
        color: white;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: bold;
      }

      .content {
        padding: 26px;
      }

      .content h2 {
        font-size: 38px;
        margin-bottom: 12px;
        font-weight: 900;
      }

      .price {
        color: #c1965c;
        font-size: 42px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .sizes {
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid #ddd;
        margin-bottom: 16px;
        font-size: 18px;
      }

      .buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .btn {
        text-decoration: none;
        text-align: center;
        padding: 16px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        transition: 0.2s;
      }

      .btn:hover {
        transform: scale(1.02);
      }

      .stripe {
        background: black;
        color: white;
      }

      .monero {
        background: #c1965c;
        color: white;
      }

      .footer {
        margin-top: 80px;
        padding: 60px 20px;
        text-align: center;
        background: white;
      }

      .footer h3 {
        font-size: 42px;
        margin-bottom: 14px;
      }

      .footer p {
        color: #666;
        font-size: 18px;
      }

      @media (max-width: 768px) {
        .hero h1 {
          font-size: 42px;
        }

        .logo {
          font-size: 30px;
        }

        .content h2 {
          font-size: 30px;
        }

        .price {
          font-size: 34px;
        }

        .card img {
          height: 340px;
        }
      }
    </style>
  </head>

  <body>
    <nav class="navbar">
      <div class="logo">
        Amic<span>Underwear</span>
      </div>
    </nav>

    <section class="hero">
      <h1>Luxury Comfort Meets Elegance</h1>

      <p>
        Premium underwear designed for confidence, softness and modern beauty.
      </p>
    </section>

    <section class="products">
      {
        products.map((product) => (
          <div class="card">
            <div class="image-wrapper">
              <img src={product.image} alt={product.name} />

              <div class="badge">{product.badge}</div>
            </div>

            <div class="content">
              <h2>{product.name}</h2>

              <div class="price">{product.price}</div>

              <select class="sizes">
                <option>XS</option>
                <option>S</option>
                <option>M</option>
                <option>L</option>
                <option>XL</option>
              </select>

              <div class="buttons">
                <a
                  href={product.stripe}
                  target="_blank"
                  class="btn stripe"
                >
                  Pay with Card
                </a>

                <a
                  href={product.monero}
                  target="_blank"
                  class="btn monero"
                >
                  Pay with Monero
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </section>

    <footer class="footer">
      <h3>Amic Underwear</h3>

      <p>
        Elegant essentials crafted for everyday luxury.
      </p>
    </footer>
  </body>
</html>
