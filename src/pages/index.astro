<html lang="en">

<head>

<meta charset="UTF-8" />

<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>

<title>AmicUnderwear</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:
linear-gradient(to bottom,#faf7f2,#f5f5f5);
color:#111;
overflow-x:hidden;
}

header{
display:flex;
justify-content:space-between;
align-items:center;
padding:22px 50px;
position:sticky;
top:0;
z-index:1000;
background:rgba(255,255,255,0.85);
backdrop-filter:blur(20px);
border-bottom:1px solid rgba(255,255,255,0.3);
}

.logo{
font-size:42px;
font-weight:700;
}

.logo span{
color:#b58a56;
}

.shop-btn{
background:black;
color:white;
padding:15px 34px;
border-radius:100px;
text-decoration:none;
font-weight:600;
transition:0.3s;
}

.shop-btn:hover{
background:#b58a56;
}

.hero{
height:85vh;

background:
linear-gradient(rgba(0,0,0,0.35),rgba(0,0,0,0.35)),
url('/images/hero.jpg');

background-size:cover;
background-position:center;

display:flex;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

.hero h1{
font-size:72px;
max-width:900px;
line-height:1.1;
color:white;
margin-bottom:25px;
}

.hero p{
font-size:22px;
color:white;
margin-bottom:35px;
}

.hero-btn{
background:#b58a56;
color:white;
padding:18px 42px;
border-radius:100px;
text-decoration:none;
font-size:20px;
font-weight:600;
}

.section-title{
text-align:center;
font-size:54px;
margin:90px 0 50px;
font-weight:700;
}

.products{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(330px,1fr));

gap:35px;

padding:0 50px 100px;
}

.card{
position:relative;

background:white;

border-radius:32px;
overflow:hidden;

box-shadow:
0 10px 30px rgba(0,0,0,0.08);

transition:0.45s;
}

.card:hover{
transform:
translateY(-12px);
}

.badge{
position:absolute;
top:20px;
left:20px;

background:#b58a56;
color:white;

padding:10px 18px;

border-radius:50px;

font-size:14px;
font-weight:600;

z-index:2;
}

.card img{
width:100%;
height:430px;
object-fit:cover;
}

.card-content{
padding:28px;
}

.card h2{
font-size:30px;
margin-bottom:10px;
}

.price{
font-size:42px;
font-weight:700;
color:#b58a56;
margin-bottom:20px;
}

.size-select,
.quantity-select{
width:100%;
padding:15px;
border-radius:16px;
border:2px solid #eee;
font-size:17px;
background:white;
margin-bottom:18px;
}

.buy-btn{
width:100%;
padding:18px;
border:none;
border-radius:100px;
background:black;
color:white;
font-size:20px;
font-weight:600;
cursor:pointer;
transition:0.3s;
}

.buy-btn:hover{
background:#b58a56;
}

/* AI GENERATOR */

.model-generator{
padding:80px 40px;
text-align:center;
}

.generator-title{
font-size:54px;
margin-bottom:20px;
}

.generator-text{
font-size:22px;
color:#666;
margin-bottom:30px;
}

.generate-btn{
background:black;
color:white;
border:none;
padding:18px 40px;
border-radius:100px;
font-size:22px;
font-weight:600;
cursor:pointer;
transition:0.3s;
}

.generate-btn:hover{
background:#b58a56;
}

.loading{
margin-top:30px;
font-size:22px;
display:none;
}

.generated-image{
margin-top:40px;
max-width:500px;
width:100%;
border-radius:30px;
display:none;
box-shadow:0 10px 40px rgba(0,0,0,0.15);
}

/* REVIEWS */

.reviews{
padding:40px 50px 100px;
}

.reviews-title{
text-align:center;
font-size:54px;
margin-bottom:50px;
font-weight:700;
}

.reviews-grid{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(280px,1fr));

gap:30px;
}

.review-card{
background:white;
padding:35px;
border-radius:30px;
box-shadow:
0 10px 30px rgba(0,0,0,0.08);
}

.stars{
font-size:28px;
color:#b58a56;
margin-bottom:20px;
}

.review-text{
font-size:20px;
line-height:1.6;
color:#444;
margin-bottom:20px;
}

.review-user{
font-size:18px;
font-weight:600;
}

/* AI VOICE */

.ai-box{
margin:40px;
padding:60px 30px;
border-radius:40px;
background:white;
text-align:center;
box-shadow:
0 10px 40px rgba(0,0,0,0.08);
}

.ai-box h2{
font-size:56px;
margin-bottom:20px;
}

.ai-text{
font-size:22px;
color:#666;
margin-bottom:35px;
}

.voice-animation{
display:flex;
justify-content:center;
align-items:flex-end;
gap:10px;
height:90px;
margin-bottom:30px;
opacity:0;
transition:0.3s;
}

.voice-animation.active{
opacity:1;
}

.voice-animation span{
width:16px;
height:20px;
background:#b58a56;
border-radius:100px;
animation:wave 1s infinite ease-in-out;
}

.voice-animation span:nth-child(2){
animation-delay:0.1s;
}

.voice-animation span:nth-child(3){
animation-delay:0.2s;
}

.voice-animation span:nth-child(4){
animation-delay:0.3s;
}

.voice-animation span:nth-child(5){
animation-delay:0.4s;
}

.ai-buttons{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.ai-btn{
padding:18px 38px;
border:none;
border-radius:100px;
background:black;
color:white;
font-size:20px;
font-weight:600;
cursor:pointer;
}

footer{
padding:50px;
text-align:center;
font-size:18px;
color:#777;
}

@keyframes wave{

0%{
height:20px;
}

50%{
height:80px;
}

100%{
height:20px;
}

}

@media(max-width:768px){

.hero h1{
font-size:42px;
}

.products{
padding:20px;
}

.section-title,
.generator-title,
.reviews-title,
.ai-box h2{
font-size:38px;
}

.card img{
height:340px;
}

}

</style>

</head>

<body>

<header>

<div class="logo">
Amic<span>Underwear</span>
</div>

<a href="#shop" class="shop-btn">
Shop
</a>

</header>

<section class="hero">

<div>

<h1>
Luxury Underwear Powered By Elegance & AI
</h1>

<p>
Experience premium comfort with intelligent luxury styling.
</p>

<a href="#shop" class="hero-btn">
Explore Collection
</a>

</div>

</section>

<h2 class="section-title" id="shop">
Featured Collection
</h2>

<section class="products">

{
products.map((product)=>(

<div class="card">

<div class="badge">
{product.badge}
</div>

<img src={product.image} alt={product.name} />

<div class="card-content">

<h2>{product.name}</h2>

<div class="price">
{product.price}
</div>

<select class="size-select">

{
product.sizes.map((size)=>(

<option value={size}>
{size}
</option>

))
}

</select>

<select class="quantity-select">

<option>1</option>
<option>2</option>
<option>3</option>

</select>

<button
class="buy-btn"
onclick={`window.open('${product.link}','_blank')`}
>
Buy Now
</button>

</div>

</div>

))
}

</section>

<!-- AI MODEL GENERATOR -->

<section class="model-generator">

<h2 class="generator-title">
AI Fashion Model Generator
</h2>

<p class="generator-text">
Generate luxury AI models wearing your products.
</p>

<button
id="generateBtn"
class="generate-btn"
>
Generate AI Model
</button>

<div
class="loading"
id="loading"
>
Generating AI Fashion Model...
</div>

<img
id="generatedImage"
class="generated-image"
/>

</section>

<!-- REVIEWS -->

<section class="reviews">

<h2 class="reviews-title">
Customer Reviews
</h2>

<div class="reviews-grid">

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
"The quality feels absolutely luxury."
</p>

<div class="review-user">
— Sophia M.
</div>

</div>

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
"Best underwear I’ve ever bought online."
</p>

<div class="review-user">
— Emma L.
</div>

</div>

<div class="review-card">

<div class="stars">
★★★★★
</div>

<p class="review-text">
"The AI stylist voice feels premium."
</p>

<div class="review-user">
— Olivia K.
</div>

</div>

</div>

</section>

<!-- AI VOICE -->

<section class="ai-box">

<h2>
AI Luxury Stylist
</h2>

<div class="ai-text">
Our AI voice assistant helps customers discover luxury collections.
</div>

<div
class="voice-animation"
id="voiceAnimation"
>

<span></span>
<span></span>
<span></span>
<span></span>
<span></span>

</div>

<div class="ai-buttons">

<button
class="ai-btn"
id="playVoiceBtn"
>
▶ Play AI Voice
</button>

<button
class="ai-btn"
id="stopVoiceBtn"
>
■ Stop Voice
</button>

</div>

</section>

<footer>
© 2026 AmicUnderwear
</footer>

<script>

/* AI MODEL */

const generateBtn =
document.getElementById("generateBtn");

const generatedImage =
document.getElementById("generatedImage");

const loading =
document.getElementById("loading");

generateBtn.addEventListener("click", async()=>{

loading.style.display =
"block";

generatedImage.style.display =
"none";

try{

const response =
await fetch("/api/generate-model",{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

prompt:
"Ultra realistic luxury female fashion model wearing elegant luxury lingerie, studio lighting, luxury fashion campaign, photorealistic"

})

});

const data =
await response.json();

if(data?.urls?.get){

pollPrediction(data.urls.get);

}else{

loading.style.display =
"none";

alert("AI generation failed");

}

}catch(error){

loading.style.display =
"none";

alert("AI generation failed");

}

});

async function pollPrediction(url){

const interval =
setInterval(async()=>{

const response =
await fetch(url);

const prediction =
await response.json();

if(prediction.status === "succeeded"){

clearInterval(interval);

loading.style.display =
"none";

generatedImage.src =
prediction.output[0];

generatedImage.style.display =
"block";

}

if(prediction.status === "failed"){

clearInterval(interval);

loading.style.display =
"none";

alert("Generation failed");

}

},3000);

}

/* AI VOICE */

const playBtn =
document.getElementById("playVoiceBtn");

const stopBtn =
document.getElementById("stopVoiceBtn");

const voiceAnimation =
document.getElementById("voiceAnimation");

let speechUtterance = null;

function loadVoices(){

return new Promise((resolve)=>{

let voices =
speechSynthesis.getVoices();

if(voices.length){

resolve(voices);

return;

}

speechSynthesis.onvoiceschanged = ()=>{

voices =
speechSynthesis.getVoices();

resolve(voices);

};

});

}

playBtn.addEventListener("click", async()=>{

try{

window.speechSynthesis.cancel();

voiceAnimation.classList.add("active");

const voices =
await loadVoices();

speechUtterance =
new SpeechSynthesisUtterance(
"Welcome to Amic Underwear. Experience premium elegance powered by AI."
);

speechUtterance.lang =
"en-US";

const femaleVoice =
voices.find((voice)=>

voice.name.includes("Samantha") ||
voice.name.includes("Google UK English Female")

);

if(femaleVoice){

speechUtterance.voice =
femaleVoice;

}

speechUtterance.onend = ()=>{

voiceAnimation.classList.remove("active");

};

window.speechSynthesis.speak(
speechUtterance
);

}catch(error){

alert("AI Voice Failed");

}

});

stopBtn.addEventListener("click",()=>{

window.speechSynthesis.cancel();

voiceAnimation.classList.remove("active");

});

</script>

</body>

</html>
