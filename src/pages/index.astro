---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AmicBridge | Forex Education & Market Insights</title>
    <meta
      name="description"
      content="AmicBridge helps users learn forex, analyze markets, and make their own trading decisions with education, market insights, and trading tools."
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <div class="brand">
          <a href="/" class="brand-logo">
            <span class="brand-dark">AMIC</span><span class="brand-blue">BRIDGE</span>
          </a>
          <p class="brand-tagline">Forex education & market insights</p>
        </div>

        <nav class="menu">
          <a href="#learn">Learn</a>
          <a href="#insights">Market Insights</a>
          <a href="#tools">Trading Tools</a>
          <a href="#resources">Resources</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>

        <a href="#learn" class="nav-cta">Start Learning</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-left">
            <div class="eyebrow">🎓 YOUR KNOWLEDGE. YOUR EDGE.</div>

            <h1>Learn Forex.<br />Analyze Markets.<br />Trade Smarter.</h1>

            <p class="hero-text">
              AmicBridge is a forex education and market insights platform designed
              to help you understand currency markets and make your own trading
              decisions.
            </p>

            <ul class="feature-list">
              <li>
                <span class="feature-icon">📊</span>
                <span>Market insights & analysis</span>
              </li>
              <li>
                <span class="feature-icon">📚</span>
                <span>Educational content for all levels</span>
              </li>
              <li>
                <span class="feature-icon">🛠️</span>
                <span>Trading tools & resources</span>
              </li>
              <li>
                <span class="feature-icon">🧠</span>
                <span>Learn to trade independently</span>
              </li>
            </ul>

            <div class="hero-actions">
              <a href="#learn" class="btn btn-primary">Start Learning</a>
              <a href="#tools" class="btn btn-secondary">Explore Tools</a>
            </div>
          </div>

          <div class="hero-right">
            <div class="info-card important-card">
              <div class="important-content">
                <div class="card-title-row">
                  <div class="warning-icon">⚠️</div>
                  <h2>Important</h2>
                </div>

                <p>
                  AmicBridge does not manage funds, execute trades on your behalf,
                  or guarantee profits.
                </p>
                <p>All trading decisions are made by you.</p>
              </div>

              <div class="shield-wrap" aria-hidden="true">
                <div class="shield-circle">✓</div>
              </div>
            </div>

            <div class="info-card features-card">
              <h3>What you get with AmicBridge</h3>

              <div class="tool-grid">
                <div class="tool-item">
                  <div class="tool-icon">🔎</div>
                  <h4>Learn</h4>
                  <p>Step-by-step lessons to build your forex knowledge.</p>
                </div>

                <div class="tool-item">
                  <div class="tool-icon">📈</div>
                  <h4>Analyze</h4>
                  <p>Access market insights and expert analysis.</p>
                </div>

                <div class="tool-item">
                  <div class="tool-icon">🛠️</div>
                  <h4>Use Tools</h4>
                  <p>Powerful calculators and tools to support your strategy.</p>
                </div>

                <div class="tool-item">
                  <div class="tool-icon">👤</div>
                  <h4>Make Decisions</h4>
                  <p>You stay in control. Make your own informed decisions.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="learn" class="simple-section">
        <div class="container">
          <h2>Learn Forex With Structure</h2>
          <p>
            Start with fundamentals, understand price action, manage risk, and
            build confidence in your own trading process.
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          AmicBridge provides educational content and market insights only. We do
          not provide financial advice, manage funds, or guarantee profits.
          Trading involves risk.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #f4f6fb;
    --surface: #ffffff;
    --surface-soft: #f7f9fc;
    --surface-blue: #eef4ff;
    --text: #111827;
    --muted: #667085;
    --border: #d8e0eb;
    --primary: #2648a5;
    --primary-dark: #1f3a86;
    --badge-bg: #dceeff;
    --shadow: 0 10px 30px rgba(17, 24, 39, 0.05);
    --radius: 24px;
    --container: 1280px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(var(--container), calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header {
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .nav {
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 24px;
    justify-content: space-between;
  }

  .brand {
    min-width: 220px;
  }

  .brand-logo {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    line-height: 1;
    display: inline-block;
  }

  .brand-dark {
    color: var(--text);
  }

  .brand-blue {
    color: var(--primary);
  }

  .brand-tagline {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 36px;
    font-weight: 600;
    color: #1f2937;
  }

  .menu a {
    transition: color 0.2s ease;
  }

  .menu a:hover {
    color: var(--primary);
  }

  .nav-cta {
    background: var(--primary);
    color: white;
    padding: 14px 26px;
    border-radius: 14px;
    font-weight: 700;
    box-shadow: var(--shadow);
    transition: background 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
  }

  .hero {
    padding: 72px 0 64px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .hero-left {
    padding-top: 8px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--badge-bg);
    color: #0f69a8;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 10px 18px;
    border-radius: 999px;
    margin-bottom: 24px;
  }

  h1 {
    margin: 0 0 24px;
    font-size: clamp(3rem, 6vw, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 900;
    max-width: 640px;
  }

  .hero-text {
    max-width: 640px;
    font-size: 1.55rem;
    line-height: 1.45;
    color: var(--muted);
    margin: 0 0 30px;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 34px;
    display: grid;
    gap: 16px;
    max-width: 640px;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 1.45rem;
    color: #445065;
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #edf2ff;
    font-size: 1.35rem;
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 30px;
    border-radius: 16px;
    font-size: 1.1rem;
    font-weight: 800;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
    box-shadow: var(--shadow);
  }

  .btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: white;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: #b8c4d6;
    transform: translateY(-1px);
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-card {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .important-card {
    background: var(--surface-blue);
    padding: 32px 28px;
    display: grid;
    grid-template-columns: 1.25fr 220px;
    gap: 20px;
    align-items: center;
    min-height: 280px;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .warning-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .important-card h2 {
    margin: 0;
    font-size: 2.15rem;
    line-height: 1.1;
    font-weight: 900;
  }

  .important-card p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 1.55rem;
    line-height: 1.45;
    max-width: 580px;
  }

  .shield-wrap {
    position: relative;
    width: 190px;
    height: 190px;
    margin-left: auto;
    border: 10px solid #d7e5ff;
    border-radius: 38% 38% 46% 46% / 30% 30% 55% 55%;
    transform: rotate(0deg);
    opacity: 0.95;
  }

  .shield-wrap::before {
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 36% 36% 46% 46% / 30% 30% 55% 55%;
    background: transparent;
  }

  .shield-circle {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 82px;
    height: 82px;
    border-radius: 999px;
    background: #adc7f6;
    color: white;
    display: grid;
    place-items: center;
    font-size: 2.4rem;
    font-weight: 900;
    top: 44px;
  }

  .features-card {
    background: #fbfcfe;
    padding: 30px;
  }

  .features-card h3 {
    margin: 0 0 28px;
    font-size: 2.2rem;
    line-height: 1.15;
    font-weight: 900;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .tool-item {
    padding: 8px 22px 10px 0;
    min-height: 200px;
  }

  .tool-item + .tool-item {
    border-left: 1px solid #e4eaf3;
    padding-left: 28px;
  }

  .tool-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef3ff;
    font-size: 1.8rem;
    margin-bottom: 18px;
  }

  .tool-item h4 {
    margin: 0 0 12px;
    font-size: 1.8rem;
    font-weight: 800;
  }

  .tool-item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
    font-size: 1.28rem;
  }

  .simple-section {
    padding: 32px 0 80px;
  }

  .simple-section h2 {
    margin: 0 0 12px;
    font-size: 2.2rem;
  }

  .simple-section p {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 760px;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: white;
  }

  .footer-inner {
    padding: 24px 0 34px;
  }

  .footer-inner p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    font-size: 0.98rem;
  }

  @media (max-width: 1200px) {
    .menu {
      gap: 22px;
      font-size: 0.95rem;
    }

    .hero-grid {
      gap: 32px;
    }

    .important-card {
      grid-template-columns: 1fr;
    }

    .shield-wrap {
      margin: 10px 0 0 auto;
    }

    .tool-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .tool-item,
    .tool-item + .tool-item {
      border-left: none;
      padding: 0;
      min-height: auto;
    }
  }

  @media (max-width: 980px) {
    .nav {
      flex-wrap: wrap;
      padding: 18px 0;
    }

    .menu {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 16px 22px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 48px;
    }
  }

  @media (max-width: 640px) {
    .container {
      width: min(var(--container), calc(100% - 24px));
    }

    .brand-logo {
      font-size: 1.6rem;
    }

    .brand-tagline {
      font-size: 0.92rem;
    }

    .nav-cta {
      padding: 12px 18px;
      border-radius: 12px;
      font-size: 0.95rem;
    }

    .eyebrow {
      font-size: 0.8rem;
      padding: 8px 14px;
    }

    .hero-text {
      font-size: 1.15rem;
    }

    .feature-list li {
      font-size: 1.05rem;
      gap: 12px;
    }

    .feature-icon {
      width: 38px;
      height: 38px;
      font-size: 1.1rem;
      border-radius: 12px;
    }

    .btn {
      width: 100%;
    }

    .important-card {
      padding: 22px 18px;
      min-height: auto;
    }

    .important-card h2 {
      font-size: 1.6rem;
    }

    .important-card p {
      font-size: 1.05rem;
    }

    .shield-wrap {
      width: 130px;
      height: 130px;
    }

    .shield-circle {
      width: 60px;
      height: 60px;
      font-size: 1.8rem;
      top: 26px;
    }

    .features-card {
      padding: 22px 18px;
    }

    .features-card h3 {
      font-size: 1.55rem;
    }

    .tool-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .tool-item h4 {
      font-size: 1.3rem;
    }

    .tool-item p {
      font-size: 1rem;
    }
  }
</style>
