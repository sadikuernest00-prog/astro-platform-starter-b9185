
---
const products = [
  {
    name: "Elegant Lace Set",
    price: "599 NOK",
    image: "/images/lace-set.jpg",
    badge: "BEST SELLER",
    badgeColor: "#c49a5c",
    payment: "https://nowpayments.io/payment/?iid=4680546954&paymentId=5747508343"
  },

  {
    name: "Midnight Black Collection",
    price: "549 NOK",
    image: "/images/black-night.jpg",
    badge: "NEW",
    badgeColor: "#c49a5c",
    payment: "#"
  },

  {
    name: "Luxury Sports Bra",
    price: "499 NOK",
    image: "/images/black-sports-bra.jpg",
    badge: "HOT",
    badgeColor: "#c49a5c",
    payment: "#"
  },

  {
    name: "White Sports Bra",
    price: "499 NOK",
    image: "/images/white-sports-bra.jpg",
    badge: "LIMITED",
    badgeColor: "#c49a5c",
    payment: "#"
  },

  {
    name: "Nude Collection",
    price: "459 NOK",
    image: "/images/nude-sports-bra.jpg",
    badge: "TRENDING",
    badgeColor: "#c49a5c",
    payment: "#"
  },

  {
    name: "Soft Nude Cami",
    price: "529 NOK",
    image: "/images/nude-cami.jpg",
    badge: "LUXURY",
    badgeColor: "#c49a5c",
    payment: "#"
  }
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AmicUnderwear</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, Helvetica, sans-serif;
    }

    body{
      background:#f5f5f5;
      color:black;
    }

    header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:30px 40px;
      background:white;
      position:sticky;
      top:0;
      z-index:999;
      border-bottom:1px solid #eee;
    }

    .logo{
      font-size:58px;
      font-weight:900;
      letter-spacing:-3px;
    }

    .logo span{
      color:#c49a5c;
    }

    .shop-btn{
      background:black;
      color:white;
      padding:18px 34px;
      border-radius:999px;
      border:none;
      font-size:22px;
      font-weight:700;
      cursor:pointer;
    }

    .hero{
      padding:120px 20px 80px;
      text-align:center;
    }

    .hero h1{
      font-size:92px;
      font-weight:900;
      line-height:0.95;
      letter-spacing:-4px;
      max-width:1200px;
      margin:auto;
    }

    .hero p{
      margin-top:30px;
      font-size:34px;
      color:#666;
      max-width:900px;
      margin-left:auto;
      margin-right:auto;
      line-height:1.4;
    }

    .hero button{
      margin-top:45px;
      background:black;
      color:white;
      border:none;
      padding:28px 60px;
      border-radius:999px;
      font-size:28px;
      font-weight:800;
      cursor:pointer;
    }

    .products{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(380px,1fr));
      gap:30px;
      padding:50px 20px 120px;
      max-width:1700px;
      margin:auto;
    }

    .card{
      background:white;
      border-radius:35px;
      overflow:hidden;
      position:relative;
      transition:0.3s;
    }

    .card:hover{
      transform:translateY(-10px);
    }

    .badge{
      position:absolute;
      top:20px;
      left:20px;
      color:white;
      padding:14px 24px;
      border-radius:999px;
      font-size:22px;
      font-weight:800;
      z-index:5;
    }

    .card img{
      width:100%;
      height:700px;
      object-fit:cover;
      background:#eee;
    }

    .card-content{
      padding:30px;
    }

    .card h2{
      font-size:58px;
      font-weight:900;
      line-height:1;
      margin-bottom:20px;
      letter-spacing:-2px;
    }

    .price{
      color:#c49a5c;
      font-size:72px;
      font-weight:900;
      margin-bottom:25px;
    }

    select{
      width:100%;
      padding:18px;
      font-size:28px;
      border-radius:16px;
      border:2px solid #eee;
      margin-bottom:22px;
    }

    .buy-btn{
      width:100%;
      background:black;
      color:white;
      border:none;
      padding:28px;
      border-radius:999px;
      font-size:34px;
      font-weight:900;
      cursor:pointer;
      margin-bottom:18px;
    }

    .buy-btn:hover{
      opacity:0.9;
    }

    .crypto-btn{
      width:100%;
      background:#c49a5c;
      color:white;
      border:none;
      padding:24px;
      border-radius:999px;
      font-size:28px;
      font-weight:900;
      cursor:pointer;
    }

    .crypto-btn:hover{
      opacity:0.9;
    }

    .reviews{
      padding:100px 20px;
      background:white;
      text-align:center;
    }

    .reviews h2{
      font-size:70px;
      font-weight:900;
      margin-bottom:60px;
    }

    .review-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
      gap:30px;
      max-width:1400px;
      margin:auto;
    }

    .review{
      background:#f5f5f5;
      border-radius:30px;
      padding:40px;
      text-align:left;
    }

    .review .stars{
      font-size:30px;
      margin-bottom:20px;
      color:#c49a5c;
    }

    .review p{
      font-size:24px;
      line-height:1.6;
      color:#444;
    }

    .review h3{
      margin-top:25px;
      font-size:24px;
    }

    footer{
      padding:80px 20px;
      background:black;
      color:white;
      text-align:center;
    }

    footer h2{
      font-size:60px;
      margin-bottom:20px;
    }

    footer p{
      color:#bbb;
      font-size:24px;
    }

    @media(max-width:900px){

      .logo{
        font-size:40px;
      }

      .hero h1{
        font-size:56px;
      }

      .hero p{
        font-size:24px;
      }

      .card h2{
        font-size:42px;
      }

      .price{
        font-size:52px;
      }

      .card img{
        height:500px;
      }

      .products{
        grid-template-columns:1fr;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="logo">
    Amic<span>Underwear</span>
  </div>

  <button class="shop-btn">
    Shop
  </button>
</header>

<section class="hero">
  <h1>
    Luxury Underwear Made For Confidence
  </h1>

  <p>
    Premium feminine essentials designed for elegance, comfort, beauty and luxury.
  </p>

  <button onclick="document.querySelector('.products').scrollIntoView({behavior:'smooth'})">
    Explore Collection
  </button>
</section>

<section class="products">

  {
    products.map((product) => (

      <div class="card">

        <div
          class="badge"
          style={`background:${product.badgeColor}`}
        >
          {product.badge}
        </div>

        <img src={product.image} alt={product.name} />

        <div class="card-content">

          <h2>{product.name}</h2>

          <div class="price">
            {product.price}
          </div>

          <select>
            <option>XS</option>
            <option>S</option>
            <option>M</option>
            <option>L</option>
            <option>XL</option>
          </select>

          <button
            class="buy-btn"
            onclick={`window.open('${product.payment}', '_blank')`}
          >
            Buy With Monero
          </button>

          <button
            class="crypto-btn"
            onclick={`window.open('${product.payment}', '_blank')`}
          >
            Secure Crypto Checkout
          </button>

        </div>

      </div>

    ))
  }

</section>

<section class="reviews">

  <h2>
    Loved By Customers
  </h2>

  <div class="review-grid">

    <div class="review">
      <div class="stars">★★★★★</div>

      <p>
        The quality feels incredibly premium and elegant. Best underwear I have bought online.
      </p>

      <h3>
        — Sophia M.
      </h3>
    </div>

    <div class="review">
      <div class="stars">★★★★★</div>

      <p>
        Beautiful fit, luxurious materials and amazing comfort. Shipping was fast too.
      </p>

      <h3>
        — Emma R.
      </h3>
    </div>

    <div class="review">
      <div class="stars">★★★★★</div>

      <p>
        The lace collection looks stunning in real life. Feels designer quality.
      </p>

      <h3>
        — Olivia K.
      </h3>
    </div>

  </div>

</section>

<footer>

  <h2>
    AmicUnderwear
  </h2>

  <p>
    Luxury essentials crafted for confidence.
  </p>

</footer>

</body>
</html>
